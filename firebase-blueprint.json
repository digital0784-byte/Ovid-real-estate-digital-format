        "id": { "type": "string" },
        "type": { "type": "string" },
        "zone": { "type": "string" },
        "requestedBy": { "type": "string" },
        "approvedBy": { "type": "string" },
        "expiry": { "type": "string" },
        "status": { "type": "string" },

        "consultant": { "type": "string" },
        "comments": { "type": "string" }
      },
      "required": ["id", "task", "status"]
    },
    "SiteDiaryLog": {
      "title": "SiteDiaryLog",
      "description": "Daily digital site diary logs, weather, attendance, activities, and engineer notes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "weather": { "type": "string" },
        "attendance": { "type": "string" },
        "surveyResults": { "type": "string" },
        "activities": { "type": "string" },
        "photos": { "type": "string" },
        "droneImages": { "type": "string" },
        "safetyIncidents": { "type": "string" },
        "materialUsage": { "type": "string" },
        "equipmentUsage": { "type": "string" },
        "concreteActivities": { "type": "string" },
        "visitors": { "type": "string" },
        "engineerNotes": { "type": "string" },
        "supervisorNotes": { "type": "string" },
        "aiSummary": { "type": "string" }

      "required": ["category", "planned", "actual"]
    },
    "AiRiskAssessment": {
      "title": "AiRiskAssessment",
      "description": "AI-generated risk assessments predicting delays, high winds, shortfalls, and quality anomalies.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "desc": { "type": "string" },
        "recommendation": { "type": "string" }

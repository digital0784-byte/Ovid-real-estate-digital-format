      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string" },
        "text": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "duration": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string" }

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return ('role' in request.auth.token)
        ? request.auth.token.role
        : (
            firestore.exists(/databases/ai-studio-ovidrealestateal-2aa0489d-a7f9-4ce4-a1a5-8c801423f125/documents/users/$(request.auth.uid))
              ? firestore.get(/databases/ai-studio-ovidrealestateal-2aa0489d-a7f9-4ce4-a1a5-8c801423f125/documents/users/$(request.auth.uid)).data.role
              : 'Pending'
          );
    }

    function isApproved() {
      return isSignedIn() && role() != 'Pending';
    }

    function hasAnyRole(roles) {
      return isApproved() && role() in roles;
    }

    function isImage() {
      return request.resource != null && request.resource.contentType.matches('image/.*');
    }

    function isDocument() {
      return request.resource != null && (
        request.resource.contentType.matches('application/pdf') ||
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('application/octet-stream') ||
        request.resource.contentType.matches('application/vnd.*') ||
        request.resource.contentType.matches('application/msword') ||
        request.resource.contentType.matches('text/.*')
      );
    }

    function isValidSize(maxBytes) {
      return request.resource != null && request.resource.size <= maxBytes;
    }

    // Default safety net: lock everything
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Worker profile photos & ID cards (up to 5MB)
    match /workers/{workerId}/{fileName} {
      allow read: if isApproved();
      allow write: if hasAnyRole(['Super Admin', 'Head Office', 'Director', 'Directory', 'HR Manager', 'HR', 'Project Manager', 'Time Keeper']) &&
                      isImage() && isValidSize(5 * 1024 * 1024);
    }

    // HRM Employee profile photos & supporting contracts/Fayda IDs/certificates
    match /hrm/employees/{employeeId}/docs/{fileName} {
      allow read: if hasAnyRole([
                        'Super Admin', 'Head Office', 'Director', 'Directory', 'HR Manager', 'HR',
                        'Finance Manager', 'Operation Manager', 'Auditor'
                      ]);
      allow write: if hasAnyRole(['Super Admin', 'Head Office', 'Director', 'Directory', 'HR Manager', 'HR']) &&
                      isDocument() && isValidSize(25 * 1024 * 1024);
    }

    match /hrm/employees/{employeeId}/{fileName} {
      allow read: if isApproved();
      allow write: if hasAnyRole(['Super Admin', 'Head Office', 'Director', 'Directory', 'HR Manager', 'HR', 'Project Manager']) &&
                      isImage() && isValidSize(10 * 1024 * 1024);
    }

    // User avatars & attachments (up to 5MB)
    match /users/{userId}/{fileName} {
      allow read: if isApproved() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isApproved() && request.auth.uid == userId && isImage() && isValidSize(5 * 1024 * 1024);
    }

    // Aluminum Formwork panel photos & damage inspection images (up to 10MB)
    match /panelTraceability/{panelId}/{fileName} {
      allow read: if isApproved();
      allow write: if hasAnyRole([
                        'Super Admin', 'Head Office', 'Director', 'Directory', 'Project Manager', 'Site Engineer',
                        'Office & Technical Engineering', 'Supervisor', 'Store Manager', 'Warehouse Manager', 'Store Owner', 'Site Store Owner'
                      ]) && isImage() && isValidSize(10 * 1024 * 1024);
    }

    // Site progress inspection photos (up to 10MB)
    match /inspections/{inspectionId}/{fileName} {
      allow read: if isApproved();
      allow write: if hasAnyRole([
                        'Super Admin', 'Head Office', 'Director', 'Directory', 'Project Manager', 'Site Engineer',
                        'Office & Technical Engineering', 'Supervisor', 'QA/QC Engineer', 'Quality Inspector', 'Safety Officer', 'HSE Officer'
                      ]) && isImage() && isValidSize(10 * 1024 * 1024);
    }

    // CAD drawings, blueprints, and project documents (up to 50MB)
    match /cadDrawings/{drawingId}/{fileName} {
      allow read: if isApproved();
      allow write: if hasAnyRole([
                        'Super Admin', 'Head Office', 'Director', 'Directory', 'Project Manager', 'Site Engineer',
                        'Office & Technical Engineering', 'CAD Engineer', 'Surveyor'
                      ]) && isDocument() && isValidSize(50 * 1024 * 1024);
    }

    // General project documents and vault files (up to 50MB)
    match /projectDocs/{docId}/{fileName} {
      allow read: if isApproved();
      allow write: if hasAnyRole([
                        'Super Admin', 'Head Office', 'Director', 'Directory', 'Project Manager', 'HR Manager', 'HR',
                        'Finance Manager', 'Operation Manager', 'Site Engineer', 'Office & Technical Engineering'
                      ]) && isDocument() && isValidSize(50 * 1024 * 1024);
    }

    // Commercial Invoices for Goods Receiving Vouchers (PDF/JPG/JPEG/PNG up to 15MB)
    match /commercialInvoices/{invoiceId}/{fileName} {
      allow read: if hasAnyRole([
                        'Super Admin', 'Head Office', 'Director', 'Directory', 'Warehouse Manager',
                        'Finance Manager', 'Accountant', 'Operation Manager', 'Auditor', 'Project Manager', 'Section Head'
                      ]);
      allow write: if hasAnyRole([
                        'Super Admin', 'Head Office', 'Warehouse Manager'
                      ]) && request.resource != null && (
                        request.resource.contentType == 'application/pdf' ||
                        request.resource.contentType.matches('image/jpeg') ||
                        request.resource.contentType.matches('image/png') ||
                        request.resource.contentType.matches('image/jpg')
                      ) && isValidSize(15 * 1024 * 1024);
    }

    // Return / Quarantine / Gate Pass Supporting Attachments (up to 15MB)
    match /materialAttachments/{docId}/{fileName} {
      allow read: if isApproved();
      allow write: if hasAnyRole([
                        'Super Admin', 'Head Office', 'Warehouse Manager', 'Store Owner',
                        'Store Manager', 'Site Store Owner', 'Gate Security Officer', 'Material Handling', 'Driver'
                      ]) && isDocument() && isValidSize(15 * 1024 * 1024);
    }
  }
}

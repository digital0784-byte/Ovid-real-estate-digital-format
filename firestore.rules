rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default safety net: Lock down all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // SECURITY UTILITIES & HELPER FUNCTIONS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Retrieve active user profile and roles from the secure users collection safely
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() && ('role' in getUserData()) ? getUserData().role : 'Pending';
    }

    // Approved active user check (blocks Pending / suspended accounts)
    function isApprovedUser() {
      return isSignedIn() &&
        userDocExists() &&
        ('status' in getUserData()) &&
        getUserData().status == 'Active' &&
        getUserRole() != 'Pending';
    }

    // MASTER SWITCH (owner decision): MFA is OFF. To enforce it again, make this return true, publish the rules,
    // and also set MFA_ENFORCED=true on the server and VITE_MFA_ENFORCED=true in the client build.
    function mfaEnforced() {
      return false;
    }

    function isSensitiveRole() {
      return mfaEnforced() && getUserRole() in ['Head Office', 'Project Manager', 'Section Head', 'Finance Manager'];
    }

    function hasFreshMfa() {
      return isSignedIn() &&
        ('mfaAt' in request.auth.token) &&
        (request.time.toMillis() - int(request.auth.token.mfaAt) <= 43200000);
    }

    function mfaSafe() {
      return !isSensitiveRole() || hasFreshMfa();
    }

    // Role membership predicates (active & non-Pending required; single AST lookup per set)
    function hasRole(role) {
      return isApprovedUser() && getUserRole() == role;
    }

    function hasAnyRole(roles) {
      return isApprovedUser() && getUserRole() in roles;
    }

    function isSuperAdmin() {
      return isApprovedUser() && (
        getUserRole() == 'Super Admin' ||
        (('role' in request.auth.token) && request.auth.token.role == 'Super Admin')
      );
    }

    function isHeadOffice() {
      return hasRole('Head Office');
    }

    function isProjectManager() {
      return hasRole('Project Manager');
    }

    function isSiteEngineer() {
      return hasRole('Site Engineer');
    }

    function isOfficeTechnicalEngineering() {
      return hasRole('Office & Technical Engineering');
    }

    function isSupervisor() {
      return hasRole('Supervisor');
    }

    function isTimeKeeper() {
      return hasRole('Time Keeper');
    }

    function isStoreManager() {
      return hasRole('Store Manager');
    }

    function isWarehouseManager() {
      return hasAnyRole(['Warehouse Manager', 'warehouse_manager']);
    }

    function isStoreOwner() {
      return hasAnyRole(['Store Owner', 'Site Store Owner', 'site_store_owner']);
    }

    function isAdminOrHeadOffice() {
      return isSuperAdmin() || hasAnyRole(['Head Office', 'admin', 'head_office']);
    }

    function isWarehouseRole() {
      return isSuperAdmin() || hasAnyRole(['Head Office', 'admin', 'head_office', 'Warehouse Manager', 'warehouse_manager']);
    }

    function isSiteStoreRole() {
      return isSuperAdmin() || hasAnyRole(['Head Office', 'admin', 'head_office', 'Store Owner', 'Site Store Owner', 'site_store_owner', 'Store Manager']);
    }

    function isAuthorizedForSite(siteName) {
      return isAdminOrHeadOffice() || (
        isSiteStoreRole() && (
          !userDocExists() ||
          !('assignedSite' in getUserData()) ||
          getUserData().assignedSite == '' ||
          getUserData().assignedSite == siteName ||
          getUserData().assignedProject == siteName
        )
      );
    }

    function isAuthorizedForWarehouse(warehouseName) {
      return isAdminOrHeadOffice() || (
        isWarehouseRole() && (
          !userDocExists() ||
          !('assignedWarehouse' in getUserData()) ||
          getUserData().assignedWarehouse == '' ||
          getUserData().assignedWarehouse == warehouseName
        )
      );
    }

    function isStrictHrManagerRole() {
      return hasRole('HR Manager');
    }

    function isHRManager() {
      return hasAnyRole(['HR Manager', 'HR']);
    }

    function isOfficeManager() {
      return hasRole('Office Manager');
    }

    function isOperationManager() {
      return hasRole('Operation Manager');
    }

    function isSectionHead() {
      return hasRole('Section Head');
    }

    function isDirectorOrAdmin() {
      return isSuperAdmin() || hasAnyRole(['Head Office', 'admin', 'head_office', 'Director', 'Directory']);
    }

    function isHrmOfficer() {
      return isSuperAdmin() || hasAnyRole(['Head Office', 'admin', 'head_office', 'Director', 'Directory', 'HR Manager', 'HR']);
    }

    function isHrmWorkflowApprover() {
      return isSuperAdmin() || hasAnyRole([
        'Head Office', 'admin', 'head_office', 'Director', 'Directory',
        'HR Manager', 'HR', 'Office Manager', 'Office & Technical Engineering',
        'Operation Manager', 'Finance Manager', 'Project Manager', 'Section Head'
      ]);
    }

    function isBiometricMappingViewer() {
      return isSuperAdmin() || hasAnyRole([
        'Head Office', 'admin', 'head_office', 'Director', 'Directory',
        'HR Manager', 'HR', 'Project Manager', 'Section Head',
        'Operation Manager', 'Office Manager', 'Office & Technical Engineering', 'Site Engineer'
      ]);
    }

    function isFinanceManager() {
      return hasRole('Finance Manager');
    }

    function isAccountant() {
      return hasRole('Accountant');
    }

    function isFinanceStaff() {
      return isSuperAdmin() || hasAnyRole(['Head Office', 'admin', 'head_office', 'Director', 'Directory', 'Finance Manager', 'Accountant']);
    }

    function isAuditor() {
      return hasRole('Auditor');
    }

    function isDirectorStrict() {
      return isSuperAdmin() || hasAnyRole(['Director', 'Directory']);
    }

    function isWarehouseManagerStrict() {
      return isSuperAdmin() || hasAnyRole(['Warehouse Manager', 'warehouse_manager']);
    }

    function isOfficeManagerEngineer() {
      return hasAnyRole(['Office Manager', 'Office & Technical Engineering', 'Office Manager Engineer']);
    }

    function isProjectHead() {
      return hasAnyRole(['Project Manager', 'Section Head', 'Project Head']);
    }

    function isMaterialHandler() {
      return hasAnyRole(['Material Handling', 'Driver', 'Assembler']);
    }

    function isGateSecurityOfficer() {
      return hasAnyRole(['Gate Security Officer', 'Security Officer']);
    }

    function canReadWarehouseModule() {
      return isApprovedUser() && (
        isDirectorStrict() ||
        isAdminOrHeadOffice() ||
        isFinanceManager() ||
        isWarehouseRole() ||
        isSiteStoreRole() ||
        isOfficeManagerEngineer() ||
        isOperationManager() ||
        isProjectHead() ||
        isMaterialHandler() ||
        isGateSecurityOfficer() ||
        isAuditor()
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ID validation sanity check
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==========================================
    // MODULE-SPECIFIC RULE MATCHING
    // ==========================================

    // Server-only TOTP secrets collection (never readable/writable from clients)
    match /mfa_secrets/{id} {
      allow read, write: if false;
    }

    // 1. Users collection, Registrants & Role Change Requests
    match /users/{userId} {
      allow get: if isOwner(userId) || isApprovedUser();
      allow list: if isApprovedUser();
      allow create: if (isSuperAdmin() && mfaSafe()) || (
        (isDirectorOrAdmin() || isHRManager()) &&
        mfaSafe() &&
        incoming().role != 'Super Admin'
      ) || (
        (isOwner(userId) || (isSignedIn() && (
          ('uid' in incoming() && incoming().uid == request.auth.uid) ||
          ('id' in incoming() && incoming().id == request.auth.uid)
        ))) &&
        incoming().keys().hasOnly([
          'displayName', 'email', 'phoneNumber', 'role', 'status', 'createdAt', 'updatedAt',
          'employeeId', 'name', 'department', 'trade', 'position', 'requestedRole',
          'id', 'uid'
        ]) &&
        incoming().role == 'Pending' &&
        incoming().status == 'Pending'
      );
      allow update: if (isSuperAdmin() && mfaSafe()) || (
        (isDirectorOrAdmin() || isHRManager()) &&
        mfaSafe() &&
        incoming().role != 'Super Admin' &&
        existing().role != 'Super Admin'
      ) || (
        (isOwner(userId) || (isSignedIn() && (
          ('uid' in incoming() && incoming().uid == request.auth.uid) ||
          ('id' in incoming() && incoming().id == request.auth.uid)
        ))) &&
        (isOwner(userId) || (('uid' in existing()) && existing().uid == request.auth.uid)) &&
        incoming().role == existing().role &&
        incoming().status == existing().status &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'phoneNumber', 'createdAt', 'updatedAt',
          'employeeId', 'name', 'department', 'trade', 'position', 'requestedRole',
          'id', 'uid'
        ])
      );
      allow delete: if isSuperAdmin() && mfaSafe();
    }

    match /registrants/{regId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isHRManager() || (
        isSignedIn() && (
          regId == request.auth.uid ||
          (resource != null && (
            ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
            ('uid' in resource.data && resource.data.uid == request.auth.uid)
          ))
        )
      );
      allow create: if (isSuperAdmin() && mfaSafe()) || (
        (isHeadOffice() || isHRManager()) &&
        mfaSafe() &&
        (!('role' in incoming()) || incoming().role != 'Super Admin')
      ) || (
        isSignedIn() && (
          regId == request.auth.uid ||
          ('userId' in incoming() && incoming().userId == request.auth.uid) ||
          ('uid' in incoming() && incoming().uid == request.auth.uid)
        ) &&
        (!('role' in incoming()) || incoming().role == 'Pending') &&
        (!('status' in incoming()) || incoming().status == 'Pending')
      );
      allow update: if (isSuperAdmin() && mfaSafe()) || (
        (isHeadOffice() || isHRManager()) &&
        mfaSafe() &&
        (!('role' in incoming()) || incoming().role != 'Super Admin') &&
        (!('role' in existing()) || existing().role != 'Super Admin')
      );
      allow delete: if (isSuperAdmin() && mfaSafe()) || (
        isHeadOffice() &&
        mfaSafe() &&
        (!('role' in existing()) || existing().role != 'Super Admin')
      );
    }

    match /role_change_requests/{reqId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isHRManager() || (
        isSignedIn() && (
          reqId == request.auth.uid ||
          (resource != null && (
            ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
            ('uid' in resource.data && resource.data.uid == request.auth.uid)
          ))
        )
      );
      allow create: if (isSuperAdmin() && mfaSafe()) || (
        (isHeadOffice() || isHRManager()) &&
        mfaSafe() &&
        (!('role' in incoming()) || incoming().role != 'Super Admin') &&
        (!('requestedRole' in incoming()) || incoming().requestedRole != 'Super Admin')
      ) || (
        isSignedIn() && (
          reqId == request.auth.uid ||
          ('userId' in incoming() && incoming().userId == request.auth.uid) ||
          ('uid' in incoming() && incoming().uid == request.auth.uid)
        ) &&
        (!('role' in incoming()) || incoming().role != 'Super Admin') &&
        (!('requestedRole' in incoming()) || incoming().requestedRole != 'Super Admin')
      );
      allow update: if (isSuperAdmin() && mfaSafe()) || (
        (isHeadOffice() || isHRManager()) &&
        mfaSafe() &&
        (!('role' in incoming()) || incoming().role != 'Super Admin') &&
        (!('role' in existing()) || existing().role != 'Super Admin') &&
        (!('requestedRole' in incoming()) || incoming().requestedRole != 'Super Admin') &&
        (!('requestedRole' in existing()) || existing().requestedRole != 'Super Admin')
      );
      allow delete: if (isSuperAdmin() && mfaSafe()) || (
        isHeadOffice() &&
        mfaSafe() &&
        (!('role' in existing()) || existing().role != 'Super Admin') &&
        (!('requestedRole' in existing()) || existing().requestedRole != 'Super Admin')
      );
    }

    match /roles/{roleId} {
      allow read: if isApprovedUser();
      allow write: if (isSuperAdmin() && mfaSafe()) || (
        isAdminOrHeadOffice() &&
        mfaSafe() &&
        roleId != 'Super Admin' &&
        (!('role' in incoming()) || incoming().role != 'Super Admin') &&
        (!('role' in existing()) || existing().role != 'Super Admin')
      );
    }

    // 2. Projects, Sites & Registered Sites / Warehouses (Role-Scoped)
    match /projects/{projectId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /sites/{siteId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /registeredSites/{siteId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || (isSiteStoreRole() && isAuthorizedForSite(siteId)) || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /siteStores/{storeId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || (isSiteStoreRole() && isAuthorizedForSite(storeId));
      allow delete: if isAdminOrHeadOffice();
    }

    match /registeredWarehouses/{warehouseId} {
      allow read: if isApprovedUser();
      allow create, update: if (isWarehouseRole() && isAuthorizedForWarehouse(warehouseId));
      allow delete: if isAdminOrHeadOffice();
    }

    match /warehouses/{warehouseId} {
      allow read: if isApprovedUser();
      allow create, update: if (isWarehouseRole() && isAuthorizedForWarehouse(warehouseId));
      allow delete: if isAdminOrHeadOffice();
    }

    match /zones/{zoneId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    match /floorZones/{fzId} {
      allow read: if isApprovedUser();
      allow create, update: if isSiteStoreRole() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    // 3. Employees, Workers & Teams
    function hasNoProhibitedBiometricTemplates() {
      return !incoming().keys().hasAny([
        'fingerprintTemplate', 'faceTemplate', 'rawBiometricTemplate',
        'biometricTemplate', 'biometricTemplateEncrypted', 'fingerprint',
        'faceRecognitionData', 'devicePassword', 'commKey'
      ]);
    }

    function biometricEnrollmentFieldsUnchanged() {
      return !incoming().diff(existing()).affectedKeys().hasAny([
        'biometricEnrollmentStatus', 'biometricWorkflowStage', 'biometricDeviceId',
        'biometricDeviceName', 'biometricDeviceModel', 'biometricDeviceSerialNumber',
        'biometricDeviceUserId', 'biometricEnrollmentDate', 'biometricMappingStatus',
        'biometricMappingId', 'biometricAttendanceActivated',
        'biometricAttendanceActivatedAt', 'biometricEnrolledBy',
        'biometricEnrolledByUid', 'biometricRegistered'
      ]);
    }

    function hasNoEnrollmentActivationOnCreate() {
      return (!('biometricDeviceId' in incoming()) || incoming().biometricDeviceId == '') &&
        (!('biometricDeviceUserId' in incoming()) || incoming().biometricDeviceUserId == '') &&
        (!('biometricAttendanceActivated' in incoming()) || incoming().biometricAttendanceActivated == false) &&
        (!('biometricEnrollmentStatus' in incoming()) || incoming().biometricEnrollmentStatus == 'Not Registered');
    }

    function isValidHrOnboardingTransaction() {
      return ('recruitmentRequestId' in incoming()) &&
        incoming().recruitmentRequestId is string &&
        incoming().recruitmentRequestId.size() > 0 &&
        exists(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId)) &&
        get(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId)).data.workflowStage == 'Approved' &&
        get(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId)).data.hrRegistrationAuthorized == true &&
        (
          (!('hiredCount' in get(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId)).data) ? 0 : get(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId)).data.hiredCount)
          < get(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId)).data.requestedCount
        ) &&
        getAfter(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId)).data.hiredCount ==
        (
          (!('hiredCount' in get(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId)).data) ? 0 : get(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId)).data.hiredCount) + 1
        );
    }

    match /employees/{employeeId} {
      allow read: if isHrmOfficer() || isFinanceManager() || (
        isApprovedUser() && (
          ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
          ('uid' in resource.data && resource.data.uid == request.auth.uid)
        )
      );
      allow create: if isValidId(employeeId) && hasNoProhibitedBiometricTemplates() && (
        (isSuperAdmin() && hasNoEnrollmentActivationOnCreate()) || (
          isHRManager() &&
          (!('role' in incoming()) || incoming().role != 'Super Admin') &&
          isValidHrOnboardingTransaction()
        ) || (
          hasAnyRole(['Head Office', 'admin', 'head_office']) &&
          hasNoEnrollmentActivationOnCreate() &&
          (!('role' in incoming()) || incoming().role != 'Super Admin')
        )
      );
      allow update: if isValidId(employeeId) && hasNoProhibitedBiometricTemplates() && (
        (isSuperAdmin() && biometricEnrollmentFieldsUnchanged()) || (
          isHRManager() &&
          (!('role' in incoming()) || incoming().role != 'Super Admin') &&
          (!('role' in existing()) || existing().role != 'Super Admin')
        ) || (
          hasAnyRole(['Head Office', 'admin', 'head_office']) &&
          biometricEnrollmentFieldsUnchanged() &&
          (!('role' in incoming()) || incoming().role != 'Super Admin') &&
          (!('role' in existing()) || existing().role != 'Super Admin')
        )
      );
      allow delete: if isSuperAdmin() || (
        isAdminOrHeadOffice() &&
        (!('role' in existing()) || existing().role != 'Super Admin')
      );
    }

    match /workers/{workerId} {
      allow read: if isApprovedUser();
      allow create: if isValidId(workerId) && hasNoProhibitedBiometricTemplates() && (
        isSuperAdmin() ||
        (isHRManager() && isValidHrOnboardingTransaction()) ||
        ((isDirectorOrAdmin() || hasAnyRole(['Project Manager', 'Supervisor', 'Section Head'])) && hasNoEnrollmentActivationOnCreate())
      );
      allow update: if isValidId(workerId) && hasNoProhibitedBiometricTemplates() && (
        isHRManager() ||
        ((isDirectorOrAdmin() || hasAnyRole(['Project Manager', 'Supervisor', 'Section Head'])) && biometricEnrollmentFieldsUnchanged())
      );
      allow delete: if isHrmOfficer();
    }

    match /teams/{teamId} {
      allow read: if isApprovedUser();
      allow create, update: if isDirectorOrAdmin() || isHRManager() || isProjectManager() || isSupervisor() || isSectionHead();
      allow delete: if isDirectorOrAdmin();
    }

    // 4. Attendance & Worker Evaluations
    match /attendance/{attendanceId} {
      allow read: if isApprovedUser();
      allow create: if isValidId(attendanceId) &&
        (isDirectorOrAdmin() || isHRManager() || isTimeKeeper() || isSupervisor() || isSectionHead() || isProjectManager() || isOperationManager() || (
          isApprovedUser() && ('recordedByUid' in incoming()) && incoming().recordedByUid == request.auth.uid
        )) &&
        !('fingerprintTemplate' in incoming()) &&
        !('faceTemplate' in incoming()) &&
        !('rawBiometricTemplate' in incoming()) &&
        !('biometricTemplate' in incoming()) &&
        !('devicePassword' in incoming()) &&
        !('commKey' in incoming()) &&
        (!('finalApprovalStatus' in incoming()) || !(incoming().finalApprovalStatus in ['Approved', 'Rejected']) || isStrictHrManagerRole()) &&
        (!('payrollFinalized' in incoming()) || incoming().payrollFinalized == false || isStrictHrManagerRole());
      allow update: if isValidId(attendanceId) &&
        (
          isDirectorOrAdmin() || isHRManager() || isTimeKeeper() || isSupervisor() || isSectionHead() || isProjectManager() || isOperationManager() || (
            isApprovedUser() && ('recordedByUid' in incoming()) && incoming().recordedByUid == request.auth.uid
          ) || (
            (isSiteEngineer() || isOfficeManager()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'discrepancyFlag', 'finalApprovalStatus', 'hrReviewStatus', 'payrollFinalized',
              'approvalAuditHistory', 'originalBiometricSnapshot', 'timezone', 'capturedAt', 'serverReceivedAt'
            ]) &&
            incoming().finalApprovalStatus == 'Under Review'
          )
        ) &&
        !('fingerprintTemplate' in incoming()) &&
        !('faceTemplate' in incoming()) &&
        !('rawBiometricTemplate' in incoming()) &&
        !('biometricTemplate' in incoming()) &&
        !('devicePassword' in incoming()) &&
        !('commKey' in incoming()) &&
        // Never overwrite or erase the original biometric event snapshot once captured
        (!('originalBiometricSnapshot' in existing()) || ('originalBiometricSnapshot' in incoming() && incoming().originalBiometricSnapshot == existing().originalBiometricSnapshot)) &&
        // ONLY HR Manager can set finalApprovalStatus to Approved/Rejected or finalize for payroll
        (
          !('finalApprovalStatus' in incoming()) ||
          !(incoming().finalApprovalStatus in ['Approved', 'Rejected']) ||
          (('finalApprovalStatus' in existing()) && incoming().finalApprovalStatus == existing().finalApprovalStatus) ||
          isStrictHrManagerRole()
        ) &&
        (
          !('payrollFinalized' in incoming()) ||
          incoming().payrollFinalized == false ||
          (('payrollFinalized' in existing()) && existing().payrollFinalized == true) ||
          isStrictHrManagerRole()
        );
      allow delete: if isDirectorOrAdmin();
    }

    match /evaluations/{evaluationId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isSupervisor() || isProjectManager() || isHRManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 5. Payroll (MFA enforced for sensitive roles on writes)
    match /payroll/{payrollId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isHRManager() || isProjectManager() || isAuditor() || (
        isApprovedUser() && (
          ('workerId' in resource.data && resource.data.workerId == request.auth.uid) ||
          ('employeeId' in resource.data && resource.data.employeeId == request.auth.uid)
        )
      );
      allow create, update: if (isAdminOrHeadOffice() || isFinanceManager() || isHRManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    match /payrolls/{payrollId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isHRManager() || isProjectManager() || isAuditor() || (
        isApprovedUser() && (
          ('workerId' in resource.data && resource.data.workerId == request.auth.uid) ||
          ('employeeId' in resource.data && resource.data.employeeId == request.auth.uid)
        )
      );
      allow create, update: if (isAdminOrHeadOffice() || isFinanceManager() || isHRManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 6. Materials, Material Categories, Inventory & Audits
    match /materials/{materialId} {
      allow read: if isApprovedUser();
      allow create: if isWarehouseRole();
      allow update: if isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialCategories/{categoryId} {
      allow read: if isApprovedUser();
      allow create, update: if isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /inventory/{inventoryId} {
      allow read: if isApprovedUser();
      allow create, update: if isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /inventoryAudits/{auditId} {
      allow read: if isWarehouseRole() || isSiteStoreRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow create, update: if isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    // 7. Equipment & Vehicles
    match /equipment/{equipmentId} {
      allow read: if isApprovedUser();
      allow create, update: if isWarehouseRole() || isSiteStoreRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /vehicles/{vehicleId} {
      allow read: if isApprovedUser();
      allow create, update: if isWarehouseRole() || isSiteStoreRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    // 8. Formwork Panels & Panel Logs (Readable by approved users for ERP Dashboard & analytics; writes role-restricted)
    match /formworkPanels/{panelId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isDirectorOrAdmin() || isWarehouseRole();
    }

    match /panelMovementLogs/{logId} {
      allow read: if isApprovedUser();
      allow create, update: if isDirectorOrAdmin() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isDirectorOrAdmin();
    }

    match /panelDamageReports/{reportId} {
      allow read: if isApprovedUser();
      allow create, update: if isDirectorOrAdmin() || isWarehouseRole() || isSiteStoreRole() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor();
      allow delete: if isDirectorOrAdmin();
    }

    match /panelRepairRecords/{recordId} {
      allow read: if isApprovedUser();
      allow create, update: if isDirectorOrAdmin() || isWarehouseRole();
      allow delete: if isDirectorOrAdmin();
    }

    // 9. Warehouse & Site Store Canonical Workflows
    match /overseasShipments/{shipmentId} {
      allow read: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow write: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
    }

    match /customsRecords/{recordId} {
      allow read: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow write: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
    }

    match /suppliers/{supplierId} {
      allow read: if isApprovedUser();
      allow create, update: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /supplierSchedules/{scheduleId} {
      allow read: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow create, update: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /goodsReceipts/{grnId} {
      allow read: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow create, update: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockAdjustments/{adjustmentId} {
      allow read: if isWarehouseRole() || isAdminOrHeadOffice();
      allow create, update: if isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockTransactions/{transactionId} {
      allow read: if isWarehouseRole() || isSiteStoreRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow create: if isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice();
      allow update, delete: if false; // Immutable audit ledger
    }

    match /stockTransfers/{transferId} {
      allow read: if isApprovedUser();
      allow create: if isWarehouseRole() || isSiteStoreRole();
      allow update: if isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dispatchTransfers/{transferId} {
      allow read: if isApprovedUser();
      allow create: if isWarehouseRole();
      allow update: if isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockDiscrepancies/{discrepancyId} {
      allow read: if isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice();
      allow create: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow update: if isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /siteReceivingReports/{reportId} {
      allow read: if isApprovedUser();
      allow create, update: if isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialIssues/{recordId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialIssueRecords/{recordId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialReturns/{recordId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialReturnRecords/{recordId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialRequests/{requestId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && (
        isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice() || isProjectHead() || isSupervisor() || isSiteEngineer()
      ) && (
        !('status' in incoming()) ||
        !(incoming().status in ['Director Approved', 'Director Disapproved']) ||
        isDirectorStrict()
      );
      allow update: if isApprovedUser() && (
        (
          ('status' in incoming()) &&
          incoming().status in ['Director Approved', 'Director Disapproved'] &&
          isDirectorStrict()
        ) ||
        (
          (!('status' in incoming()) || !(incoming().status in ['Director Approved', 'Director Disapproved'])) &&
          (isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice() || isProjectManager()) &&
          (!('status' in existing()) || !(existing().status in ['Director Approved', 'Director Disapproved']) || isWarehouseRole() || isSuperAdmin())
        )
      );
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockCounts/{countId} {
      allow read: if isSiteStoreRole() || isAdminOrHeadOffice() || isWarehouseRole();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /damagedMissingReports/{reportId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    match /truckFleets/{fleetId} {
      allow read: if isApprovedUser();
      allow create, update: if isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /sitePanelBreakdowns/{breakdownId} {
      allow read: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole() || isProjectManager();
      allow create, update: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dailyRequisitions/{reqId} {
      allow read: if isApprovedUser();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isSupervisor() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dailyConsumptionVariances/{varId} {
      allow read: if isSiteStoreRole() || isProjectManager() || isAdminOrHeadOffice() || isWarehouseRole();
      allow create, update: if isSiteStoreRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /requisitionAuditLogs/{logId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create: if isApprovedUser();
      allow update, delete: if false; // Immutable audit log
    }

    match /dailyReturnReports/{repId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dailyConsolidatedReports/{repId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dailyMaterialReports/{reportId} {
      allow read: if isApprovedUser();
      allow create, update: if isSiteStoreRole() || isAdminOrHeadOffice() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /enhancedMaterialRequests/{requestId} {
      allow read: if isAdminOrHeadOffice() || isSiteStoreRole() || isProjectManager() ||
                     (isApprovedUser() && resource.data.requesterUid == request.auth.uid) ||
                     (isApprovedUser() && 'assignedSite' in getUserData() && getUserData().assignedSite == resource.data.site);
      allow create: if (isApprovedUser() && (
                      isAdminOrHeadOffice() || isSiteStoreRole() ||
                      (request.resource.data.requesterUid == request.auth.uid)
                    ));
      allow update: if isAdminOrHeadOffice() ||
                     // Site store owner can approve/reject/issue, but requester CANNOT approve own request
                     (isSiteStoreRole() && (isSuperAdmin() || resource.data.requesterUid != request.auth.uid)) ||
                     // Requester can confirm receipt or cancel draft
                     (isApprovedUser() && resource.data.requesterUid == request.auth.uid && request.resource.data.status in ['RECEIVED', 'CONSUMED', 'PARTIALLY_RETURNED', 'RETURNED', 'CLOSED']);
      allow delete: if isAdminOrHeadOffice();
    }

    match /enhancedMaterialIssues/{issueId} {
      allow read: if isAdminOrHeadOffice() || isSiteStoreRole() ||
                     (isApprovedUser() && resource.data.requesterUid == request.auth.uid) ||
                     (isApprovedUser() && resource.data.receivedByUid == request.auth.uid);
      allow create: if isSiteStoreRole() || isAdminOrHeadOffice();
      allow update: if isSiteStoreRole() || isAdminOrHeadOffice() ||
                     (isApprovedUser() && request.auth.uid == resource.data.receivedByUid);
      allow delete: if isAdminOrHeadOffice();
    }

    match /enhancedMaterialReturns/{returnId} {
      allow read: if isAdminOrHeadOffice() || isSiteStoreRole() ||
                     (isApprovedUser() && resource.data.userUid == request.auth.uid);
      allow create: if isApprovedUser();
      allow update: if isSiteStoreRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockReservations/{resId} {
      allow read, write: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
    }

    match /inventoryDiscrepancies/{discrepancyId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isAdminOrHeadOffice() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    // 10. CAD Files & Site Operational Logs
    match /cadFiles/{cadId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || hasRole('CAD Engineer') || hasRole('Surveyor');
      allow delete: if isAdminOrHeadOffice() || isProjectManager();
    }

    match /dailyReports/{reportId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    match /progressLogs/{logId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    match /qualityLogs/{logId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || hasRole('QA/QC Engineer') || hasRole('Quality Inspector');
      allow delete: if isAdminOrHeadOffice();
    }

    match /qualitySnags/{snagId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor() || hasRole('QA/QC Engineer');
      allow delete: if isAdminOrHeadOffice();
    }

    match /safetyLogs/{logId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor() || hasRole('Safety Officer') || hasRole('HSE Officer');
      allow delete: if isAdminOrHeadOffice();
    }

    match /concreteTruckLogs/{truckId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    // 11. Notifications
    match /notifications/{notifId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser();
      allow update: if isApprovedUser() && (
        isAdminOrHeadOffice() ||
        (resource != null && (
          ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
          ('recipientId' in resource.data && resource.data.recipientId == request.auth.uid)
        ))
      );
      allow delete: if isAdminOrHeadOffice() || (
        isApprovedUser() && (
          resource != null && (
            ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
            ('recipientId' in resource.data && resource.data.recipientId == request.auth.uid)
          )
        )
      );
    }

    // 12. Approvals
    match /approvals/{approvalId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser();
      allow update: if isAdminOrHeadOffice() || isProjectManager() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 12.1 Tasks (Digital Construction ERP Tasks Management + HRM Recruitment & Onboarding Tasks)
    match /tasks/{taskId} {
      allow read: if isApprovedUser();
      allow create: if mfaSafe() && (
        isHrmWorkflowApprover() ||
        isSiteEngineer() ||
        isSupervisor() ||
        hasAnyRole(['Team Leader', 'Gang Chief']) ||
        (isApprovedUser() && ('createdById' in incoming()) && incoming().createdById == request.auth.uid)
      );
      allow update: if mfaSafe() && (
        isHrmWorkflowApprover() ||
        isSiteEngineer() ||
        isSupervisor() ||
        hasAnyRole(['Team Leader', 'Gang Chief']) ||
        (isApprovedUser() && resource != null && (
          ('assignedToId' in resource.data && resource.data.assignedToId == request.auth.uid) ||
          ('assignedToUserIds' in resource.data && request.auth.uid in resource.data.assignedToUserIds) ||
          ('createdById' in resource.data && resource.data.createdById == request.auth.uid)
        ))
      );
      allow delete: if isDirectorOrAdmin() || isProjectManager();
    }

    // 13. Expenses, Invoices, & Contracts (MFA enforced on writes for sensitive roles)
    match /expenses/{expenseId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    match /invoices/{invoiceId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    match /contracts/{contractId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 14. Audit Logs (read for Director/Admin/HR/Finance/Accountant/Auditor, create for approved users, immutable)
    match /auditLogs/{logId} {
      allow read: if isDirectorOrAdmin() || isHRManager() || isFinanceManager() || isAccountant() || isAuditor();
      allow create: if isApprovedUser() && (
        !('userId' in incoming()) ||
        incoming().userId == request.auth.uid ||
        isDirectorOrAdmin()
      );
      allow update, delete: if false; // Immutable audit log
    }

    // 15. Admin Invitations (MFA enforced on writes)
    match /invitations/{inviteId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isHRManager();
      allow create: if (isSuperAdmin() && mfaSafe()) || (
        (isHeadOffice() || isHRManager()) &&
        mfaSafe() &&
        (!('role' in incoming()) || incoming().role != 'Super Admin')
      );
      allow update: if (isSuperAdmin() && mfaSafe()) || (
        (isHeadOffice() || isHRManager()) &&
        mfaSafe() &&
        (!('role' in incoming()) || incoming().role != 'Super Admin') &&
        (!('role' in existing()) || existing().role != 'Super Admin')
      );
      allow delete: if isSuperAdmin() && mfaSafe();
    }

    // 16. Enterprise ERP Hub Collections (Procurement, Feedbacks, Appraisals)
    match /procurements/{procId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isFinanceManager() || isProjectManager() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /employeeFeedbacks/{feedbackId} {
      allow read: if isAdminOrHeadOffice() || isHRManager() || (
        isApprovedUser() && (
          ('employeeId' in resource.data && resource.data.employeeId == request.auth.uid) ||
          ('submittedBy' in resource.data && resource.data.submittedBy == request.auth.uid)
        )
      );
      allow create: if isApprovedUser();
      allow update: if isAdminOrHeadOffice() || isHRManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /performanceAppraisals/{appraisalId} {
      allow read: if isAdminOrHeadOffice() || isHRManager() || (
        isApprovedUser() && ('employeeId' in resource.data && resource.data.employeeId == request.auth.uid)
      );
      allow create, update: if isAdminOrHeadOffice() || isHRManager() || isProjectManager() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    // 17. Batch B Enterprise Collections
    // 17.1 enterpriseDocuments
    match /enterpriseDocuments/{docId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isHRManager() || isFinanceManager() || isOfficeTechnicalEngineering();
      allow delete: if isAdminOrHeadOffice();
    }

    // 17.2 enterpriseChatMessages
    match /enterpriseChatMessages/{messageId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser();
      allow update, delete: if isAdminOrHeadOffice() || (
        isApprovedUser() && ('senderId' in resource.data && resource.data.senderId == request.auth.uid)
      );
    }

    // 17.3 clientApprovals
    match /clientApprovals/{approvalId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 17.4 siteDiaryLogs
    match /siteDiaryLogs/{logId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    // 18. Batch C Enterprise Collections
    // 18.1 projectPermits
    match /projectPermits/{permitId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering();
      allow delete: if isAdminOrHeadOffice();
    }

    // 18.2 enterpriseAssets
    match /enterpriseAssets/{assetId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isWarehouseRole() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 18.3 maintenanceSchedules
    match /maintenanceSchedules/{scheduleId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    // 18.4 costTrackingItems (MFA enforced on writes for sensitive roles)
    match /costTrackingItems/{itemId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isProjectManager();
      allow create, update: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 19. Batch D Enterprise Collections
    // 19.1 aiRiskAssessments
    match /aiRiskAssessments/{riskId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || hasRole('Safety Officer') || hasRole('HSE Officer');
      allow delete: if isAdminOrHeadOffice();
    }

    // 19.2 trainingRecords
    match /trainingRecords/{recordId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isHRManager() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 19.3 apiIntegrationLogs
    match /apiIntegrationLogs/{logId} {
      allow read: if isAdminOrHeadOffice();
      allow create: if isApprovedUser();
      allow update, delete: if false; // Immutable system audit log
    }

    // 20. Batch E Enterprise Collections
    // 20.1 backupLogs
    match /backupLogs/{logId} {
      allow read: if isAdminOrHeadOffice();
      allow create: if isAdminOrHeadOffice();
      allow update, delete: if false; // Immutable backup audit log
    }

    // 20.2 approvalWorkflows
    match /approvalWorkflows/{workflowId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isHRManager() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 21. Finance ERP Collections (MFA enforced on writes for sensitive roles)
    // 21.1 projectBudgets
    match /projectBudgets/{budgetId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.2 paymentRecords
    match /paymentRecords/{paymentId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.3 financialTargets (Monthly Planned Revenue, Expense, Collection, Payment)
    match /financialTargets/{targetId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.4 financialAccounts (Cash & Bank Accounts)
    match /financialAccounts/{accountId} {
      allow read: if isFinanceStaff() || isHrmOfficer() || isOperationManager() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21.5 cashTransactions (Posted Cash Collections, Payments & Transfers)
    match /cashTransactions/{txId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.6 financialSettings (Currency, Fiscal Year & Threshold Alerts)
    match /financialSettings/{settingId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.7 collectionPlans (Monthly Planned Cash Collections)
    match /collectionPlans/{planId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.8 paymentPlans (Monthly Planned Cash Payments)
    match /paymentPlans/{planId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.9 projectBudgetPlans (Part 4 Master Project Budgets & 12-Category Line Items)
    match /projectBudgetPlans/{planId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isFinanceStaff() || isProjectManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.10 budgetAllocations (Part 4 Monthly/Quarterly/Annual Budget Allocations)
    match /budgetAllocations/{allocationId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isFinanceStaff() || isProjectManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.11 budgetRevisions (Part 4 Budget Revision Requests & Approval History)
    match /budgetRevisions/{revisionId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isFinanceStaff() || isProjectManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.12 actualCostEntries (Part 4 Verified Actual Cost Ledger Entries)
    match /actualCostEntries/{costId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isFinanceStaff() || isProjectManager()) && mfaSafe();
      allow delete: if isAdminOrHeadOffice() && mfaSafe();
    }

    // 21.13 cashFlowForecastItems (Part 5 Cash Flow Forecast Entries)
    match /cashFlowForecastItems/{forecastId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if (isFinanceStaff() || isProjectManager()) && mfaSafe();
      allow delete: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
    }

    // 21.14 bankReconciliations (Part 5 & 6 Bank & Cash Account Reconciliations)
    match /bankReconciliations/{recId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe();
      allow delete: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
    }

    // 21.15 bankTransactions (Part 6 Bank Transactions Ledger)
    match /bankTransactions/{txId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe();
      allow delete: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
    }

    // 21.16 bankStatements (Part 6 Immutable Uploaded Bank Statements - Never Overwrite or Delete)
    match /bankStatements/{statementId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create: if isFinanceStaff() && mfaSafe();
      allow update, delete: if false; // Immutable original bank statements
    }

    // 21.17 chartOfAccounts (Part 7 Double-Entry Chart of Accounts)
    match /chartOfAccounts/{accountId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe();
      allow delete: if (isAdminOrHeadOffice() || isFinanceManager()) && mfaSafe();
    }

    // 21.18 journalEntries (Part 7 & Part 8 Double-Entry Journal Vouchers - Approved/Posted entries are NEVER deletable)
    match /journalEntries/{entryId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor() || isHRManager();
      allow create, update: if (isFinanceStaff() || isHRManager()) && mfaSafe() &&
        incoming().isBalanced == true &&
        incoming().totalDebit is number &&
        incoming().totalCredit is number &&
        incoming().totalDebit == incoming().totalCredit;
      allow delete: if (isDirectorOrAdmin() || isFinanceManager()) && existing().status != 'Posted' && mfaSafe();
    }

    // 21.19 financialPeriods (Part 7 & Part 8 Financial Period Closing & Statement Approval Signatures)
    match /financialPeriods/{periodId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe() && (
        incoming().status != 'Closed' || isDirectorOrAdmin() || isFinanceManager()
      );
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21.20 financialYears (Part 8 Financial Year Governance)
    match /financialYears/{yearId} {
      allow read: if isFinanceStaff() || isProjectManager() || isAuditor();
      allow create, update: if isFinanceStaff() && mfaSafe() && (
        incoming().status != 'Closed' || isDirectorOrAdmin() || isFinanceManager()
      );
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // ==========================================
    // 21B. HUMAN RESOURCE MANAGEMENT (HRM) COLLECTIONS
    // ==========================================
    // 21B.1 manpowerPlans (Approved Headcount Quotas)
    match /manpowerPlans/{planId} {
      allow read: if isHrmWorkflowApprover() || isAuditor();
      allow create, update: if (isDirectorOrAdmin() || isHRManager() || isFinanceManager() || isOperationManager()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.2 recruitmentRequests (Strict 6-step Sequential Manpower & Recruitment Approval Workflow + Quota Ceiling)
    match /recruitmentRequests/{requestId} {
      allow read: if isHrmWorkflowApprover() || isAuditor() || (
        isApprovedUser() && resource != null && ('requestedById' in existing() && existing().requestedById == request.auth.uid)
      );
      allow create: if isValidId(requestId) && mfaSafe() &&
        (isSectionHead() || isSuperAdmin()) &&
        incoming().requestedById == request.auth.uid &&
        incoming().workflowStage == 'Pending HR Manager' &&
        incoming().status == 'Pending' &&
        incoming().hrRegistrationAuthorized == false;
      allow update: if isValidId(requestId) && mfaSafe() &&
        existing().workflowStage != 'Rejected' && (
          isSuperAdmin() ||
          (existing().workflowStage == 'Returned for Correction' &&
            existing().requestedById == request.auth.uid &&
            incoming().requestedById == request.auth.uid &&
            incoming().workflowStage == 'Pending HR Manager' &&
            incoming().status == 'Pending') ||
          (existing().workflowStage == 'Pending HR Manager' && isHRManager() &&
            incoming().workflowStage in ['Pending Office Manager', 'Returned for Correction', 'Rejected']) ||
          (existing().workflowStage == 'Pending Office Manager' && (isOfficeManager() || isOfficeTechnicalEngineering()) &&
            incoming().workflowStage in ['Pending Finance Manager', 'Returned for Correction', 'Rejected']) ||
          (existing().workflowStage == 'Pending Finance Manager' && isFinanceManager() &&
            incoming().workflowStage in ['Pending Operation Department', 'Returned for Correction', 'Rejected']) ||
          (existing().workflowStage == 'Pending Operation Department' && isOperationManager() &&
            incoming().workflowStage in ['Pending Director Final Approval', 'Returned for Correction', 'Rejected']) ||
          (existing().workflowStage in ['Pending Director Final Approval', 'Pending Director Excess Approval'] && isDirectorOrAdmin() &&
            incoming().workflowStage in ['Approved', 'Returned for Correction', 'Rejected']) ||
          // HR onboarding 1 employee under approved request (strict quota ceiling)
          (existing().workflowStage == 'Approved' && isHRManager() &&
            incoming().requestedCount == existing().requestedCount &&
            incoming().hiredCount == ((!('hiredCount' in existing()) ? 0 : existing().hiredCount) + 1) &&
            incoming().hiredCount <= incoming().requestedCount &&
            incoming().workflowStage == (incoming().hiredCount >= incoming().requestedCount ? 'Fulfilled' : 'Approved')) ||
          // HR attaching Excess Approval Pending flag without altering requestedCount/hiredCount
          (existing().workflowStage in ['Approved', 'Fulfilled'] && isHRManager() &&
            incoming().requestedCount == existing().requestedCount &&
            (!('hiredCount' in incoming()) || incoming().hiredCount == (!('hiredCount' in existing()) ? 0 : existing().hiredCount)) &&
            incoming().workflowStage == existing().workflowStage &&
            incoming().excessApprovalStatus == 'Pending Director') ||
          // Director deciding an Excess Recruitment Request on an Approved/Fulfilled request
          (existing().workflowStage in ['Approved', 'Fulfilled'] && isDirectorOrAdmin() && (
            (incoming().excessApprovalStatus == 'Approved' &&
              incoming().requestedCount > existing().requestedCount &&
              incoming().workflowStage == 'Approved' &&
              incoming().status == 'Approved' &&
              incoming().hrRegistrationAuthorized == true) ||
            (incoming().excessApprovalStatus == 'Rejected' &&
              incoming().requestedCount == existing().requestedCount &&
              incoming().workflowStage == existing().workflowStage)
          ))
        );
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.2B excessRecruitmentRequests (Additional Director Approval when HR exceeds approved qty)
    match /excessRecruitmentRequests/{excessId} {
      allow read: if isHrmWorkflowApprover() || isAuditor();
      allow create: if isValidId(excessId) && mfaSafe() &&
        (isHRManager() || isSuperAdmin()) &&
        incoming().requestedById == request.auth.uid &&
        incoming().status == 'Pending Director' &&
        incoming().excessCount is int &&
        incoming().excessCount >= 1 &&
        incoming().justification is string &&
        incoming().justification.size() > 0 &&
        incoming().justification.size() <= 1000 &&
        exists(/databases/$(database)/documents/recruitmentRequests/$(incoming().recruitmentRequestId));
      allow update: if isValidId(excessId) && mfaSafe() &&
        isDirectorOrAdmin() &&
        existing().status == 'Pending Director' &&
        incoming().status in ['Approved', 'Rejected'] && (
          incoming().status == 'Rejected' ||
          getAfter(/databases/$(database)/documents/recruitmentRequests/$(existing().recruitmentRequestId)).data.requestedCount ==
            get(/databases/$(database)/documents/recruitmentRequests/$(existing().recruitmentRequestId)).data.requestedCount + existing().excessCount
        );
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.3 workSchedules (Shifts, Rest Days & Holiday Calendars)
    match /workSchedules/{scheduleId} {
      allow read: if isApprovedUser();
      allow create, update: if (isHrmOfficer() || isOperationManager() || isProjectManager()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.4 leaveRequests (Self-service submission + Section Head & HR Approval)
    match /leaveRequests/{leaveId} {
      allow read: if isHrmWorkflowApprover() || isAuditor() || (
        isApprovedUser() && ('createdById' in resource.data && resource.data.createdById == request.auth.uid)
      );
      allow create: if isApprovedUser() && (
        isHrmWorkflowApprover() ||
        (('createdById' in incoming()) && incoming().createdById == request.auth.uid && incoming().status == 'Pending Section Head')
      );
      allow update: if (isHrmOfficer() || isSectionHead() || isProjectManager() || isOperationManager()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.5 overtimeRequests (Self-service/Supervisor submission + HR/Section Head Approval -> Payroll)
    match /overtimeRequests/{otId} {
      allow read: if isHrmWorkflowApprover() || isAuditor() || (
        isApprovedUser() && ('createdById' in resource.data && resource.data.createdById == request.auth.uid)
      );
      allow create: if isApprovedUser() && (
        isHrmWorkflowApprover() ||
        (('createdById' in incoming()) && incoming().createdById == request.auth.uid && incoming().status == 'Pending Section Head')
      );
      allow update: if (isHrmOfficer() || isSectionHead() || isProjectManager() || isOperationManager()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.6 employeeTransfers (Site/Project Transfers & Position History)
    match /employeeTransfers/{transferId} {
      allow read: if isHrmWorkflowApprover() || isAuditor();
      allow create, update: if (isHrmOfficer() || isOperationManager() || isProjectManager()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.7 salaryStructures (Grade Salary & Allowance Matrices)
    match /salaryStructures/{structureId} {
      allow read: if isHrmOfficer() || isFinanceStaff() || isOperationManager() || isAuditor();
      allow create, update: if (isHrmOfficer() || isFinanceManager()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.8 salaryAdvancesLoans (Advance & Loan Requests + HR/Finance Approval)
    match /salaryAdvancesLoans/{loanId} {
      allow read: if isHrmOfficer() || isFinanceStaff() || isOperationManager() || isAuditor() || (
        isApprovedUser() && ('createdById' in resource.data && resource.data.createdById == request.auth.uid)
      );
      allow create: if isApprovedUser() && (
        isHrmOfficer() || isFinanceStaff() ||
        (('createdById' in incoming()) && incoming().createdById == request.auth.uid && incoming().status == 'Pending HR')
      );
      allow update: if (isHrmOfficer() || isFinanceStaff()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.9 hrmPayrollRuns (4-Tier Approved Payroll Disbursements — Paid runs are immutable)
    match /hrmPayrollRuns/{runId} {
      allow read: if isHrmOfficer() || isFinanceStaff() || isOperationManager() || isAuditor();
      allow create, update: if (isHrmOfficer() || isFinanceStaff() || isOperationManager()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && existing().workflowStage != 'Paid' && mfaSafe();
    }

    // 21B.10 taxPensionConfigs (Configurable Ethiopian Income Tax & Pension Rules)
    match /taxPensionConfigs/{configId} {
      allow read: if isHrmOfficer() || isFinanceStaff() || isOperationManager() || isAuditor();
      allow create, update: if (isDirectorOrAdmin() || isFinanceManager() || isHRManager()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.11 hrmPrivateProfiles (AES-GCM Encrypted Fayda ID, Bank Account & Biometric Ref)
    match /hrmPrivateProfiles/{workerId} {
      allow read: if isDirectorOrAdmin() || isHRManager() || isFinanceManager() || (
        isApprovedUser() && ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
      allow create, update: if (isDirectorOrAdmin() || isHRManager()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // 21B.12 hrmPayslips (Disbursed Employee Payslips with Self-Service Scoped Access)
    match /hrmPayslips/{payslipId} {
      allow read: if isHrmOfficer() || isFinanceStaff() || isOperationManager() || isAuditor() || (
        isApprovedUser() && ('workerUserId' in resource.data && resource.data.workerUserId == request.auth.uid)
      );
      allow create, update: if (isHrmOfficer() || isFinanceStaff()) && mfaSafe();
      allow delete: if isDirectorOrAdmin() && mfaSafe();
    }

    // ==========================================
    // 21C. EMPLOYEE BIOMETRIC MAPPING COLLECTIONS
    // ==========================================
    function isValidBiometricDevice() {
      return incoming().keys().hasAll([
        'id', 'deviceCode', 'deviceName', 'manufacturer', 'model', 'serialNumber', 'workLocationType', 'status'
      ]) &&
      incoming().keys().hasOnly([
        'id', 'deviceCode', 'deviceName', 'manufacturer', 'model', 'serialNumber',
        'workLocationType', 'projectId', 'projectName', 'deviceLocation',
        'protocolType', 'networkTopology', 'admsPath', 'supportedCapabilities',
        'lastHandshakeAt', 'lastEventAt', 'connectionVerified',
        'status', 'notes', 'createdBy', 'createdByUid', 'createdAt', 'updatedBy', 'updatedAt',
        'capturedAt', 'serverReceivedAt'
      ]) &&
      incoming().deviceCode is string && incoming().deviceCode.size() >= 1 && incoming().deviceCode.size() <= 64 &&
      incoming().deviceName is string && incoming().deviceName.size() >= 1 && incoming().deviceName.size() <= 140 &&
      incoming().manufacturer is string && incoming().manufacturer.size() >= 1 && incoming().manufacturer.size() <= 100 &&
      incoming().model is string && incoming().model.size() >= 1 && incoming().model.size() <= 100 &&
      incoming().serialNumber is string && incoming().serialNumber.size() >= 1 && incoming().serialNumber.size() <= 120 &&
      incoming().workLocationType in ['Head Office', 'Construction Site'] &&
      (!('protocolType' in incoming()) || incoming().protocolType in ['ADMS_PUSH_HTTP', 'TCP_4370_SITE_BRIDGE', 'MANUAL_IMPORT']) &&
      incoming().status in ['Active', 'Inactive'];
    }

    function isValidBiometricDeviceMapping() {
      return incoming().keys().hasAll([
        'id', 'employeeId', 'workerRecordId', 'biometricUserId', 'deviceId',
        'workLocationType', 'effectiveDate', 'status'
      ]) &&
      incoming().keys().hasOnly([
        'id', 'employeeId', 'workerRecordId', 'employeeNameSnapshot', 'departmentSnapshot',
        'positionSnapshot', 'employmentStatusSnapshot', 'biometricUserId', 'deviceId',
        'deviceNameSnapshot', 'deviceModelSnapshot', 'deviceSerialNumberSnapshot',
        'workLocationId', 'workLocationType', 'projectId', 'projectNameSnapshot',
        'effectiveDate', 'status', 'notes', 'createdBy', 'createdByUid', 'createdAt',
        'updatedBy', 'updatedByUid', 'updatedAt', 'deactivatedBy', 'deactivatedByUid',
        'deactivatedAt', 'deactivationReason', 'capturedAt', 'serverReceivedAt'
      ]) &&
      incoming().employeeId is string && incoming().employeeId.size() >= 1 && incoming().employeeId.size() <= 100 &&
      incoming().workerRecordId is string && incoming().workerRecordId.size() >= 1 && incoming().workerRecordId.size() <= 128 &&
      incoming().biometricUserId is string && incoming().biometricUserId.size() >= 1 && incoming().biometricUserId.size() <= 64 &&
      incoming().deviceId is string && incoming().deviceId.size() >= 1 && incoming().deviceId.size() <= 128 &&
      incoming().workLocationType in ['Head Office', 'Construction Site'] &&
      incoming().effectiveDate is string && incoming().effectiveDate.size() >= 8 && incoming().effectiveDate.size() <= 32 &&
      incoming().status in ['Active', 'Inactive'];
    }

    function isValidBiometricMappingAuditLog() {
      return incoming().keys().hasAll([
        'id', 'mappingId', 'employeeId', 'deviceId', 'biometricUserId',
        'action', 'actorName', 'actorRole', 'timestamp'
      ]) &&
      incoming().keys().hasOnly([
        'id', 'mappingId', 'employeeId', 'employeeName', 'deviceId', 'deviceName',
        'biometricUserId', 'action', 'previousValue', 'newValue', 'reason',
        'actorName', 'actorUid', 'actorRole', 'timestamp', 'serverReceivedAt'
      ]) &&
      incoming().action in [
        'Mapping Created', 'Mapping Edited', 'Biometric User ID Changed',
        'Device Changed', 'Mapping Activated', 'Mapping Deactivated', 'Unmapped Event Resolved',
        'Device Registration Recorded', 'Enrollment Status Changed', 'Attendance Activated', 'Enrollment Suspended'
      ] &&
      incoming().biometricUserId is string && incoming().biometricUserId.size() >= 1 && incoming().biometricUserId.size() <= 64 &&
      incoming().actorName is string && incoming().actorName.size() >= 1 && incoming().actorName.size() <= 120;
    }

    function isValidUnmappedBiometricEvent() {
      return incoming().keys().hasAll([
        'id', 'deviceId', 'biometricUserId', 'eventTime', 'status'
      ]) &&
      incoming().keys().hasOnly([
        'id', 'deviceId', 'deviceName', 'biometricUserId', 'eventTime', 'punchType',
        'workLocationType', 'projectName', 'status', 'exceptionCategory', 'resolvedMappingId',
        'resolvedEmployeeId', 'resolvedAttendanceId', 'resolvedBy', 'resolvedAt',
        'rawEventMeta', 'createdAt', 'updatedAt', 'capturedAt', 'serverReceivedAt'
      ]) &&
      incoming().deviceId is string && incoming().deviceId.size() >= 1 && incoming().deviceId.size() <= 128 &&
      incoming().biometricUserId is string && incoming().biometricUserId.size() >= 1 && incoming().biometricUserId.size() <= 64 &&
      incoming().eventTime is string && incoming().eventTime.size() >= 8 && incoming().eventTime.size() <= 64 &&
      incoming().status in ['Unmapped', 'Resolved', 'Ignored'] &&
      (!('exceptionCategory' in incoming()) || incoming().exceptionCategory in [
        'Unmatched Biometric ID', 'Unauthorized Device', 'Inactive Device', 'Inactive Employee'
      ]);
    }

    // 21C.1 biometricDevices (Registered biometric hardware terminals; zero secrets stored)
    match /biometricDevices/{deviceId} {
      allow read: if isBiometricMappingViewer();
      allow create, update: if isValidId(deviceId) &&
        (isSuperAdmin() || hasRole('HR Manager')) &&
        mfaSafe() &&
        isValidBiometricDevice();
      allow delete: if false; // Preserve device history; use status = 'Inactive'
    }

    // 21C.2 biometricDeviceMappings (HR Department ONLY — Links ERP employees to biometric device User IDs)
    match /biometricDeviceMappings/{mappingId} {
      allow read: if isBiometricMappingViewer();
      allow create: if isValidId(mappingId) &&
        isHRManager() &&
        mfaSafe() &&
        isValidBiometricDeviceMapping();
      allow update: if isValidId(mappingId) &&
        isHRManager() &&
        mfaSafe() &&
        isValidBiometricDeviceMapping() &&
        (incoming().status == existing().status || isStrictHrManagerRole());
      allow delete: if false; // Never hard-delete mapping history; use status = 'Inactive'
    }

    // 21C.3 biometricMappingAuditLogs (Strictly immutable create-only audit history — HR Department writes)
    match /biometricMappingAuditLogs/{logId} {
      allow read: if isBiometricMappingViewer();
      allow create: if isValidId(logId) &&
        isHRManager() &&
        mfaSafe() &&
        isValidBiometricMappingAuditLog();
      allow update, delete: if false; // Strictly immutable audit log
    }

    // 21C.4 unmappedBiometricEvents (Quarantine queue for unmatched biometric device punches)
    match /unmappedBiometricEvents/{eventId} {
      allow read: if isBiometricMappingViewer();
      allow create, update: if isValidId(eventId) &&
        isHRManager() &&
        mfaSafe() &&
        isValidUnmappedBiometricEvent();
      allow delete: if false;
    }

    // ==========================================
    // 21D. ATTENDANCE PART 2 APPROVAL, CORRECTIONS & POLICY COLLECTIONS
    // ==========================================
    function isValidAttendanceCorrection() {
      return incoming().keys().hasAll([
        'id', 'requestNo', 'attendanceId', 'workerId', 'workerName', 'date',
        'correctionType', 'originalSnapshot', 'reason', 'submittedBy', 'submittedByUid', 'status'
      ]) &&
      incoming().keys().hasOnly([
        'id', 'requestNo', 'attendanceId', 'workerId', 'employeeId', 'workerName',
        'project', 'department', 'workLocationType', 'date', 'correctionType',
        'originalSnapshot', 'proposedCheckIn', 'proposedCheckOut', 'proposedStatus',
        'reason', 'supportingEvidenceUrl', 'supportingEvidenceName', 'supportingEvidenceNote',
        'submittedBy', 'submittedByUid', 'submittedByRole', 'status',
        'hrOfficerReviewedBy', 'hrOfficerReviewedByUid', 'hrOfficerReviewedAt', 'hrOfficerNotes',
        'hrManagerDecisionBy', 'hrManagerDecisionByUid', 'hrManagerDecisionAt', 'hrManagerComments',
        'createdAt', 'updatedAt', 'capturedAt', 'serverReceivedAt'
      ]) &&
      incoming().requestNo is string && incoming().requestNo.size() >= 1 && incoming().requestNo.size() <= 64 &&
      incoming().attendanceId is string && incoming().attendanceId.size() >= 1 && incoming().attendanceId.size() <= 128 &&
      incoming().workerId is string && incoming().workerId.size() >= 1 && incoming().workerId.size() <= 128 &&
      incoming().workerName is string && incoming().workerName.size() >= 1 && incoming().workerName.size() <= 160 &&
      incoming().date is string && incoming().date.size() >= 8 && incoming().date.size() <= 32 &&
      incoming().correctionType in ['Missing Check-In', 'Missing Check-Out', 'Incorrect Attendance Record', 'Device Synchronization Failure'] &&
      incoming().originalSnapshot is map &&
      incoming().reason is string && incoming().reason.size() >= 1 && incoming().reason.size() <= 1000 &&
      incoming().submittedBy is string && incoming().submittedBy.size() >= 1 && incoming().submittedBy.size() <= 120 &&
      incoming().submittedByUid is string && incoming().submittedByUid.size() >= 1 && incoming().submittedByUid.size() <= 128 &&
      incoming().status in ['Pending', 'Under Review', 'Approved', 'Rejected', 'Returned for Correction'] &&
      (!('supportingEvidenceUrl' in incoming()) || incoming().supportingEvidenceUrl is string && incoming().supportingEvidenceUrl.size() <= 1000) &&
      (!('supportingEvidenceName' in incoming()) || incoming().supportingEvidenceName is string && incoming().supportingEvidenceName.size() <= 240) &&
      (!('supportingEvidenceNote' in incoming()) || incoming().supportingEvidenceNote is string && incoming().supportingEvidenceNote.size() <= 500) &&
      (!('hrOfficerNotes' in incoming()) || incoming().hrOfficerNotes is string && incoming().hrOfficerNotes.size() <= 1000) &&
      (!('hrManagerComments' in incoming()) || incoming().hrManagerComments is string && incoming().hrManagerComments.size() <= 1000);
    }

    function isValidAttendanceDeductionPolicy() {
      return incoming().keys().hasAll([
        'id', 'policyName', 'isApproved', 'standardWorkingDaysPerMonth'
      ]) &&
      incoming().keys().hasOnly([
        'id', 'policyName', 'isApproved', 'approvedBy', 'approvedByRole', 'approvedAt',
        'deductUnpaidLeave', 'deductUnexcusedAbsence', 'absenceDailyMultiplier',
        'lateDeductionEnabled', 'graceMinutesBeforeDeduction', 'lateDeductionHourlyFactor',
        'standardWorkingDaysPerMonth', 'notes', 'updatedBy', 'createdAt', 'updatedAt',
        'capturedAt', 'serverReceivedAt'
      ]) &&
      incoming().policyName is string && incoming().policyName.size() >= 1 && incoming().policyName.size() <= 140 &&
      incoming().isApproved is bool &&
      incoming().standardWorkingDaysPerMonth is number &&
      incoming().standardWorkingDaysPerMonth >= 1 && incoming().standardWorkingDaysPerMonth <= 31 &&
      (!('notes' in incoming()) || incoming().notes is string && incoming().notes.size() <= 1000);
    }

    function isValidAttendanceAuditLog() {
      return incoming().keys().hasAll([
        'id', 'attendanceId', 'workerId', 'workerName', 'date',
        'action', 'actorName', 'actorUid', 'actorRole', 'timestamp'
      ]) &&
      incoming().keys().hasOnly([
        'id', 'attendanceId', 'correctionId', 'workerId', 'employeeId', 'workerName',
        'date', 'action', 'previousStatus', 'newStatus', 'comments',
        'actorName', 'actorUid', 'actorRole', 'timestamp', 'timezone',
        'capturedAt', 'serverReceivedAt'
      ]) &&
      incoming().attendanceId is string && incoming().attendanceId.size() >= 1 && incoming().attendanceId.size() <= 128 &&
      incoming().workerId is string && incoming().workerId.size() >= 1 && incoming().workerId.size() <= 128 &&
      incoming().workerName is string && incoming().workerName.size() >= 1 && incoming().workerName.size() <= 160 &&
      incoming().date is string && incoming().date.size() >= 8 && incoming().date.size() <= 32 &&
      incoming().action is string && incoming().action.size() >= 1 && incoming().action.size() <= 140 &&
      incoming().actorName is string && incoming().actorName.size() >= 1 && incoming().actorName.size() <= 120 &&
      incoming().actorUid is string && incoming().actorUid.size() >= 1 && incoming().actorUid.size() <= 128 &&
      incoming().actorRole is string && incoming().actorRole.size() >= 1 && incoming().actorRole.size() <= 64 &&
      incoming().timestamp is string && incoming().timestamp.size() >= 8 && incoming().timestamp.size() <= 64 &&
      (!('comments' in incoming()) || incoming().comments is string && incoming().comments.size() <= 1000);
    }

    // 21D.1 attendanceCorrections (Preserves original biometric event; HR Manager-only approve/reject)
    match /attendanceCorrections/{correctionId} {
      allow read: if isApprovedUser();
      allow create: if isValidId(correctionId) &&
        (isHRManager() || isDirectorOrAdmin() || isProjectManager() || isOperationManager() || isSectionHead() || isOfficeManager() || isSupervisor() || isTimeKeeper()) &&
        isValidAttendanceCorrection() &&
        incoming().status == 'Pending' &&
        incoming().submittedByUid == request.auth.uid;
      allow update: if isValidId(correctionId) &&
        isValidAttendanceCorrection() &&
        incoming().originalSnapshot == existing().originalSnapshot &&
        incoming().submittedByUid == existing().submittedByUid &&
        (
          (incoming().status in ['Under Review', 'Returned for Correction'] && isHRManager()) ||
          (incoming().status in ['Approved', 'Rejected'] && isStrictHrManagerRole())
        );
      allow delete: if false;
    }

    // 21D.2 attendanceDeductionPolicies (Approved company policy gating attendance salary deductions)
    match /attendanceDeductionPolicies/{policyId} {
      allow read: if isApprovedUser();
      allow create, update: if isValidId(policyId) &&
        (isStrictHrManagerRole() || isDirectorOrAdmin()) &&
        mfaSafe() &&
        isValidAttendanceDeductionPolicy();
      allow delete: if false;
    }

    // 21D.3 attendanceAuditLogs (Strictly immutable create-only attendance approval & correction history)
    match /attendanceAuditLogs/{logId} {
      allow read: if isHrmWorkflowApprover() || isDirectorOrAdmin() || isHRManager() || isAuditor() || isTimeKeeper() || isSupervisor() || isSiteEngineer();
      allow create: if isValidId(logId) &&
        isApprovedUser() &&
        isValidAttendanceAuditLog() &&
        incoming().actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ==========================================
    // 22. Panel Traceability & Lifecycle Collections
    // ==========================================
    function isTraceabilityWriter() {
      return isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager() || isSiteEngineer() || isOfficeTechnicalEngineering() || isSupervisor() || isWarehouseRole() || isSiteStoreRole();
    }

    // 22.1 traceablePanels
    match /traceablePanels/{panelId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isApprovedUser() && isTraceabilityWriter();
    }

    // 22.2 panelTraceabilityMovements
    match /panelTraceabilityMovements/{movementId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isApprovedUser() && isTraceabilityWriter();
    }

    // 22.3 panelDamageInspections
    match /panelDamageInspections/{inspectionId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isApprovedUser() && isTraceabilityWriter();
    }

    // 22.4 panelIssueTransactions
    match /panelIssueTransactions/{issueId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isApprovedUser() && isTraceabilityWriter();
    }

    // 22.5 panelReturnTransactions
    match /panelReturnTransactions/{returnId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isApprovedUser() && isTraceabilityWriter();
    }

    // 22.6 panelInventoryReconciliations
    match /panelInventoryReconciliations/{reconciliationId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isApprovedUser() && isTraceabilityWriter();
    }

    // 22.7 panelTraceabilityAuditLogs (create-only and immutable like auditLogs; readable by approved users like sibling panel traceability collections)
    match /panelTraceabilityAuditLogs/{logId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && isTraceabilityWriter() && (
        !('userId' in incoming()) ||
        incoming().userId == request.auth.uid ||
        isDirectorOrAdmin()
      );
      allow update, delete: if false; // Immutable audit log
    }

    // 22.8 panelDimensionLibrary
    match /panelDimensionLibrary/{dimensionId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isApprovedUser() && isTraceabilityWriter();
    }

    // ==========================================
    // 23. Warehouse & Site Store Management (22 Collections + Valuation Settings)
    // ==========================================

    // 23.1 inventoryCategories
    match /inventoryCategories/{categoryId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(categoryId) && isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    // 23.2 inventoryItems
    match /inventoryItems/{itemId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(itemId) && (isWarehouseRole() || isOfficeManagerEngineer());
      allow delete: if isAdminOrHeadOffice();
    }

    // 23.3 projectStores
    match /projectStores/{storeId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(storeId) && (isWarehouseRole() || isAdminOrHeadOffice() || isSiteStoreRole());
      allow delete: if isAdminOrHeadOffice();
    }

    // 23.4 stockBalances (Non-negative available & quarantine stock enforced)
    match /stockBalances/{balanceId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(balanceId) &&
        (isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice()) &&
        ('availableQty' in incoming()) && incoming().availableQty is number && incoming().availableQty >= 0 &&
        (!('quarantineQty' in incoming()) || (incoming().quarantineQty is number && incoming().quarantineQty >= 0)) &&
        (!('reservedQty' in incoming()) || (incoming().reservedQty is number && incoming().reservedQty >= 0));
      allow delete: if isSuperAdmin();
    }

    // 23.5 stockLedger (Strictly create-only immutable stock ledger)
    match /stockLedger/{entryId} {
      allow read: if canReadWarehouseModule();
      allow create: if isValidId(entryId) &&
        (isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice()) &&
        ('voucherNo' in incoming()) && incoming().voucherNo is string && incoming().voucherNo.size() > 0 &&
        ('balanceAfter' in incoming()) && incoming().balanceAfter is number && incoming().balanceAfter >= 0;
      allow update, delete: if false;
    }

    // 23.6 materialPlans (Office Manager Engineer creates & revises; Warehouse/Director/Finance/Site Store read)
    match /materialPlans/{planId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(planId) &&
        (isOfficeManagerEngineer() || isAdminOrHeadOffice() || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // 23.7 materialPlanRevisions (Immutable revision audit log)
    match /materialPlanRevisions/{revisionId} {
      allow read: if canReadWarehouseModule();
      allow create: if isValidId(revisionId) &&
        (isOfficeManagerEngineer() || isAdminOrHeadOffice() || isSuperAdmin());
      allow update, delete: if false;
    }

    // 23.8 materialRequestItems
    match /materialRequestItems/{itemId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(itemId) &&
        (isSiteStoreRole() || isWarehouseRole() || isDirectorStrict() || isAdminOrHeadOffice());
      allow delete: if isAdminOrHeadOffice();
    }

    // 23.9 materialApprovals (Director-only final decision enforcement)
    match /materialApprovals/{approvalId} {
      allow read: if canReadWarehouseModule();
      allow create: if isValidId(approvalId) && (
        (
          incoming().stage == 'Warehouse Manager Verification' &&
          incoming().decision in ['Verified Pending Director', 'Returned by Warehouse Manager'] &&
          isWarehouseRole()
        ) ||
        (
          incoming().stage == 'Director Final Decision' &&
          incoming().decision in ['Director Approved', 'Director Disapproved'] &&
          isDirectorStrict()
        )
      );
      allow update, delete: if false;
    }

    // 23.10 commercialInvoices (PDF/JPG/PNG metadata + replacement audit trail)
    match /commercialInvoices/{invoiceId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(invoiceId) &&
        (isWarehouseRole() || isAdminOrHeadOffice()) &&
        ('invoiceNumber' in incoming()) && incoming().invoiceNumber is string && incoming().invoiceNumber.size() > 0 &&
        ('fileUrl' in incoming()) && incoming().fileUrl is string && incoming().fileUrl.size() > 0;
      allow delete: if isSuperAdmin();
    }

    // 23.11 goodsReceivingVouchers (Cannot finalize without mandatory commercial invoice)
    match /goodsReceivingVouchers/{grvId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(grvId) &&
        (isWarehouseRole() || isAdminOrHeadOffice()) &&
        (
          !(incoming().status in ['Completed', 'Verified']) ||
          (
            ('commercialInvoiceId' in incoming()) && incoming().commercialInvoiceId is string && incoming().commercialInvoiceId.size() > 0 &&
            ('commercialInvoiceNo' in incoming()) && incoming().commercialInvoiceNo is string && incoming().commercialInvoiceNo.size() > 0 &&
            ('commercialInvoiceUrl' in incoming()) && incoming().commercialInvoiceUrl is string && incoming().commercialInvoiceUrl.size() > 0
          )
        );
      allow delete: if isSuperAdmin();
    }

    // 23.12 goodsIssueVouchers (Consumables GIV dispatch)
    match /goodsIssueVouchers/{givId} {
      allow read: if canReadWarehouseModule();
      allow create: if isValidId(givId) && (isWarehouseRole() || isAdminOrHeadOffice()) &&
        ('directorApprovalId' in incoming()) && incoming().directorApprovalId is string && incoming().directorApprovalId.size() > 0;
      allow update: if isValidId(givId) && (isWarehouseRole() || isSiteStoreRole() || isMaterialHandler() || isAdminOrHeadOffice());
      allow delete: if isSuperAdmin();
    }

    // 23.13 materialReturnVouchers (Two-way MRV)
    match /materialReturnVouchers/{mrvId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(mrvId) && (isWarehouseRole() || isSiteStoreRole() || isMaterialHandler() || isAdminOrHeadOffice());
      allow delete: if isSuperAdmin();
    }

    // 23.14 fixedAssets (BIG BALANCE & per-project registers; Asset ID & Original GRV immutable)
    match /fixedAssets/{assetDocId} {
      allow read: if canReadWarehouseModule();
      allow create: if isValidId(assetDocId) &&
        (isWarehouseRole() || isAdminOrHeadOffice()) &&
        ('assetId' in incoming()) && incoming().assetId is string && incoming().assetId.size() > 0 &&
        ('originalGrvNumber' in incoming()) && incoming().originalGrvNumber is string && incoming().originalGrvNumber.size() > 0;
      allow update: if isValidId(assetDocId) &&
        (isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice()) &&
        incoming().assetId == existing().assetId &&
        incoming().originalGrvNumber == existing().originalGrvNumber &&
        incoming().originalGrvId == existing().originalGrvId;
      allow delete: if isSuperAdmin();
    }

    // 23.15 fixedAssetTransfersOut (FATOV)
    match /fixedAssetTransfersOut/{fatovId} {
      allow read: if canReadWarehouseModule();
      allow create: if isValidId(fatovId) &&
        (isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice()) &&
        ('assetId' in incoming()) && incoming().assetId is string && incoming().assetId.size() > 0 &&
        ('originalGrvNumber' in incoming()) && incoming().originalGrvNumber is string && incoming().originalGrvNumber.size() > 0;
      allow update: if isValidId(fatovId) &&
        (isWarehouseRole() || isSiteStoreRole() || isMaterialHandler() || isAdminOrHeadOffice()) &&
        incoming().assetId == existing().assetId &&
        incoming().originalGrvNumber == existing().originalGrvNumber;
      allow delete: if isSuperAdmin();
    }

    // 23.16 fixedAssetTransfersIn (FATIV)
    match /fixedAssetTransfersIn/{fativId} {
      allow read: if canReadWarehouseModule();
      allow create: if isValidId(fativId) &&
        (isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice()) &&
        ('fatovId' in incoming()) && incoming().fatovId is string && incoming().fatovId.size() > 0 &&
        ('assetId' in incoming()) && incoming().assetId is string && incoming().assetId.size() > 0 &&
        ('originalGrvNumber' in incoming()) && incoming().originalGrvNumber is string && incoming().originalGrvNumber.size() > 0;
      allow update: if isSuperAdmin() || isAdminOrHeadOffice();
      allow delete: if isSuperAdmin();
    }

    // 23.17 transportationRecords (11 lifecycle statuses)
    match /transportationRecords/{transportId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if isValidId(transportId) &&
        (isWarehouseRole() || isSiteStoreRole() || isMaterialHandler() || isOperationManager() || isGateSecurityOfficer() || isAdminOrHeadOffice());
      allow delete: if isSuperAdmin();
    }

    // 23.18 gatePasses (QR Verification & Security Exit/Entry Sign-Off)
    match /gatePasses/{gatePassId} {
      allow read: if canReadWarehouseModule();
      allow create: if isValidId(gatePassId) &&
        (isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice()) &&
        ('qrVerificationCode' in incoming()) && incoming().qrVerificationCode is string && incoming().qrVerificationCode.size() > 0;
      allow update: if isValidId(gatePassId) && (
        (
          (isGateSecurityOfficer() || isAdminOrHeadOffice()) &&
          incoming().itemsSummary == existing().itemsSummary &&
          incoming().vehicleNumber == existing().vehicleNumber &&
          incoming().voucherId == existing().voucherId
        ) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // 23.19 inventoryNotifications
    match /inventoryNotifications/{notifId} {
      allow read: if canReadWarehouseModule();
      allow create: if isApprovedUser();
      allow update: if isApprovedUser();
      allow delete: if isSuperAdmin();
    }

    // 23.20 inventoryAuditLogs (Strictly create-only immutable audit ledger)
    match /inventoryAuditLogs/{logId} {
      allow read: if canReadWarehouseModule();
      allow create: if isValidId(logId) && isApprovedUser();
      allow update, delete: if false;
    }

    // 23.21 inventorySettings (FIFO vs Weighted Moving Average — Finance Manager or Super Admin only)
    match /inventorySettings/{settingId} {
      allow read: if canReadWarehouseModule();
      allow create, update: if (isFinanceManager() || isSuperAdmin()) &&
        ('valuationMethod' in incoming()) && incoming().valuationMethod in ['FIFO', 'Weighted Moving Average'];
      allow delete: if false;
    }

    // ==========================================
    // 24. FINANCIAL MANAGEMENT ADVANCED MODULES (PARTS 9–16)
    // ==========================================

    // 24.1 financeFixedAssets (Depreciation, Transfers, Revaluation, Disposal)
    match /financeFixedAssets/{assetId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor() || isWarehouseRole();
      allow create: if isValidId(assetId) && isFinanceStaff() && mfaSafe() &&
        incoming().acquisitionCost is number && incoming().acquisitionCost >= 0 &&
        incoming().salvageValue is number && incoming().salvageValue >= 0 &&
        incoming().usefulLifeYears is number && incoming().usefulLifeYears > 0;
      allow update: if isValidId(assetId) && isFinanceStaff() && mfaSafe() &&
        incoming().acquisitionCost is number && incoming().acquisitionCost >= 0;
      allow delete: if (isDirectorStrict() || isSuperAdmin()) && mfaSafe();
    }

    // 24.2 fixedAssetEvents (Create-only asset lifecycle & depreciation audit history)
    match /fixedAssetEvents/{eventId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor();
      allow create: if isValidId(eventId) && isFinanceStaff() && mfaSafe();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // 24.3 taxRateConfigs (Effective-dated statutory tax rates)
    match /taxRateConfigs/{configId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor() || isHrmOfficer();
      allow create, update: if isValidId(configId) &&
        (isFinanceManager() || isDirectorStrict() || isSuperAdmin()) && mfaSafe() &&
        incoming().ratePct is number && incoming().ratePct >= 0 && incoming().ratePct <= 100;
      allow delete: if isSuperAdmin();
    }

    // 24.4 taxTransactions (Automated & manual tax liabilities / credits)
    match /taxTransactions/{txId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor();
      allow create: if isValidId(txId) && isFinanceStaff() && mfaSafe() &&
        incoming().taxAmount is number && incoming().taxAmount >= 0;
      allow update: if isValidId(txId) &&
        (isFinanceManager() || isDirectorStrict() || isSuperAdmin()) && mfaSafe();
      allow delete: if isSuperAdmin();
    }

    // 24.5 taxReturns (Maker-Checker enforced before Filing/Payment settlement)
    match /taxReturns/{returnId} {
      allow read: if isFinanceStaff() || isAuditor();
      allow create: if isValidId(returnId) && isFinanceStaff() && mfaSafe() &&
        incoming().preparedById == request.auth.uid &&
        incoming().status in ['Draft', 'Prepared'];
      allow update: if isValidId(returnId) && mfaSafe() && (
        isSuperAdmin() ||
        (
          (isFinanceManager() || isDirectorStrict()) &&
          incoming().status in ['Filed', 'Paid'] &&
          ('approvedById' in incoming()) &&
          incoming().approvedById != existing().preparedById
        ) ||
        (
          isFinanceStaff() &&
          !(incoming().status in ['Filed', 'Paid'])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // 24.6 loanFacilities (Maker-Checker enforced when approving Active loan)
    match /loanFacilities/{loanId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor();
      allow create: if isValidId(loanId) && isFinanceStaff() && mfaSafe() &&
        incoming().principalAmount is number && incoming().principalAmount > 0 &&
        incoming().annualInterestRatePct is number && incoming().annualInterestRatePct >= 0 &&
        incoming().termMonths is number && incoming().termMonths > 0 &&
        incoming().createdById == request.auth.uid &&
        incoming().status == 'Pending Approval';
      allow update: if isValidId(loanId) && mfaSafe() && (
        isSuperAdmin() ||
        (
          existing().status == 'Pending Approval' &&
          incoming().status == 'Active' &&
          (isFinanceManager() || isDirectorStrict()) &&
          ('approvedById' in incoming()) &&
          incoming().approvedById != existing().createdById
        ) ||
        (
          existing().status != 'Pending Approval' &&
          isFinanceStaff()
        )
      );
      allow delete: if isSuperAdmin();
    }

    // 24.7 loanRepayments (Create-only loan installment settlement ledger)
    match /loanRepayments/{repaymentId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor();
      allow create: if isValidId(repaymentId) && isFinanceStaff() && mfaSafe() &&
        incoming().principalPaid is number && incoming().principalPaid >= 0 &&
        incoming().interestPaid is number && incoming().interestPaid >= 0 &&
        incoming().totalPaid is number && incoming().totalPaid > 0;
      allow update, delete: if isSuperAdmin();
    }

    // 24.8 creditProfiles (Client credit limit & supplier credit term governance)
    match /creditProfiles/{profileId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor();
      allow create, update: if isValidId(profileId) &&
        (isFinanceManager() || isDirectorStrict() || isAccountant() || isSuperAdmin()) && mfaSafe() &&
        incoming().creditLimitEtb is number && incoming().creditLimitEtb >= 0;
      allow delete: if isSuperAdmin();
    }

    // 24.9 pettyCashFunds (Site & Head Office petty cash funds)
    match /pettyCashFunds/{fundId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor();
      allow create: if isValidId(fundId) &&
        (isFinanceManager() || isDirectorStrict() || isSuperAdmin()) && mfaSafe() &&
        incoming().authorizedLimit is number && incoming().authorizedLimit > 0 &&
        incoming().maxSingleExpense is number && incoming().maxSingleExpense > 0 &&
        incoming().currentBalance is number && incoming().currentBalance >= 0;
      allow update: if isValidId(fundId) &&
        (isFinanceStaff() || isProjectHead()) && mfaSafe() &&
        incoming().currentBalance is number && incoming().currentBalance >= 0;
      allow delete: if isSuperAdmin();
    }

    // 24.10 pettyCashTransactions (Maker-Checker enforced on posting/approval)
    match /pettyCashTransactions/{txId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor();
      allow create: if isValidId(txId) &&
        (isFinanceStaff() || isProjectHead()) && mfaSafe() &&
        incoming().amount is number && incoming().amount > 0 &&
        incoming().createdById == request.auth.uid &&
        incoming().status == 'Pending';
      allow update: if isValidId(txId) && mfaSafe() && (
        isSuperAdmin() ||
        (
          incoming().status in ['Posted', 'Approved'] &&
          (isFinanceManager() || isDirectorStrict()) &&
          ('approvedById' in incoming()) &&
          incoming().approvedById != existing().createdById
        ) ||
        (
          incoming().status == 'Rejected' &&
          (isFinanceManager() || isDirectorStrict())
        )
      );
      allow delete: if isSuperAdmin();
    }

    // 24.11 pettyCashReconciliations (Maker-Checker enforced on verification)
    match /pettyCashReconciliations/{recId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor();
      allow create: if isValidId(recId) &&
        (isFinanceStaff() || isProjectHead()) && mfaSafe() &&
        incoming().reconciledById == request.auth.uid;
      allow update: if isValidId(recId) && mfaSafe() && (
        isSuperAdmin() ||
        (
          incoming().status == 'Verified' &&
          (isFinanceManager() || isDirectorStrict() || isAuditor()) &&
          ('verifiedById' in incoming()) &&
          incoming().verifiedById != existing().reconciledById
        )
      );
      allow delete: if isSuperAdmin();
    }

    // 24.12 financialAuditFindings (Internal Audit Anomalies & CAPA)
    match /financialAuditFindings/{findingId} {
      allow read: if isFinanceStaff() || isProjectHead() || isAuditor();
      allow create, update: if isValidId(findingId) &&
        (isAuditor() || isFinanceManager() || isDirectorStrict() || isSuperAdmin()) && mfaSafe();
      allow delete: if isSuperAdmin();
    }
  }
}

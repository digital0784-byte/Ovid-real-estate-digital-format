rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default safety net: Lock down all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // SECURITY UTILITIES & HELPER FUNCTIONS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Retrieve active user profile and roles from the secure users collection safely
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() && ('role' in getUserData()) ? getUserData().role : 'Pending';
    }

    // Role membership predicates
    function hasRole(role) {
      return isSignedIn() && getUserRole() == role;
    }

    // Only Super Admin: Name Nuriye Ahmed Adem, phone 0910097862/0920843843, email mejennur669@gmail.com
    function isSuperAdmin() {
      return (isSignedIn() && (
        (('email' in request.auth.token) && request.auth.token.email == 'mejennur669@gmail.com') ||
        (('phone_number' in request.auth.token) && request.auth.token.phone_number == '+251910097862') ||
        (('phone_number' in request.auth.token) && request.auth.token.phone_number == '+251920843843') ||
        (userDocExists() && (
          (('email' in getUserData()) && getUserData().email == 'mejennur669@gmail.com') ||
          (('phoneNumber' in getUserData()) && (
            getUserData().phoneNumber == '0910097862/0920843843' ||
            getUserData().phoneNumber == '0910097862' ||
            getUserData().phoneNumber == '0920843843' ||
            getUserData().phoneNumber == '+251910097862' ||
            getUserData().phoneNumber == '+251920843843'
          ))
        ))
      )) || hasRole('Super Admin');
    }

    function isHeadOffice() {
      return hasRole('Head Office');
    }

    function isProjectManager() {
      return hasRole('Project Manager');
    }

    function isSiteEngineer() {
      return hasRole('Site Engineer');
    }

    function isSupervisor() {
      return hasRole('Supervisor');
    }

    function isTimeKeeper() {
      return hasRole('Time Keeper');
    }

    function isStoreManager() {
      return hasRole('Store Manager');
    }

    function isWarehouseManager() {
      return hasRole('Warehouse Manager') || hasRole('warehouse_manager');
    }

    function isStoreOwner() {
      return hasRole('Store Owner') || hasRole('Site Store Owner') || hasRole('site_store_owner');
    }

    function isAdminOrHeadOffice() {
      return isSuperAdmin() || isHeadOffice() || hasRole('admin') || hasRole('head_office');
    }

    function isWarehouseRole() {
      return isAdminOrHeadOffice() || isWarehouseManager();
    }

    function isSiteStoreRole() {
      return isAdminOrHeadOffice() || isStoreOwner() || isStoreManager();
    }

    function isAuthorizedForSite(siteName) {
      return isAdminOrHeadOffice() || (
        isSiteStoreRole() && (
          !userDocExists() ||
          !('assignedSite' in getUserData()) ||
          getUserData().assignedSite == '' ||
          getUserData().assignedSite == siteName ||
          getUserData().assignedProject == siteName
        )
      );
    }

    function isAuthorizedForWarehouse(warehouseName) {
      return isAdminOrHeadOffice() || (
        isWarehouseRole() && (
          !userDocExists() ||
          !('assignedWarehouse' in getUserData()) ||
          getUserData().assignedWarehouse == '' ||
          getUserData().assignedWarehouse == warehouseName
        )
      );
    }

    function isHRManager() {
      return hasRole('HR Manager');
    }

    function isFinanceManager() {
      return hasRole('Finance Manager');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ID validation sanity check
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==========================================
    // MODULE-SPECIFIC RULE MATCHING
    // ==========================================

    // 1. Users collection, Registrants & Role Change Requests
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || isHeadOffice() || isHRManager() || (
        isOwner(userId) &&
        incoming().keys().hasOnly([
          'displayName', 'email', 'phoneNumber', 'role', 'status', 'createdAt',
          'employeeId', 'name', 'department', 'trade', 'position', 'requestedRole',
          'id', 'uid'
        ]) &&
        incoming().role == 'Pending' &&
        incoming().status == 'Pending'
      );
      allow update: if isSuperAdmin() || isHeadOffice() || isHRManager() || (
        isOwner(userId) &&
        incoming().role == existing().role &&
        incoming().status == existing().status &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'phoneNumber', 'createdAt',
          'employeeId', 'name', 'department', 'trade', 'position', 'requestedRole',
          'id', 'uid'
        ])
      );
      allow delete: if isSuperAdmin();
    }
    match /registrants/{regId} {
      allow read, write: if true;
    }
    match /role_change_requests/{reqId} {
      allow read, write: if true;
    }
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrHeadOffice();
    }

    // 2. Projects, Sites & Registered Sites / Warehouses (Role-Scoped)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isSignedIn() || isSuperAdmin() || isHeadOffice() || isProjectManager();
    }
    match /sites/{siteId} {
      allow read: if true;
      allow write: if isSignedIn() || isSuperAdmin() || isHeadOffice() || isProjectManager();
    }
    match /registeredSites/{siteId} {
      allow read: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager();
      allow create, update: if !isSignedIn() || isAdminOrHeadOffice() || (isSiteStoreRole() && isAuthorizedForSite(siteId)) || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /siteStores/{storeId} {
      allow read: if !isSignedIn() || (isSiteStoreRole() && isAuthorizedForSite(storeId)) || isWarehouseRole() || isProjectManager();
      allow create, update: if !isSignedIn() || isAdminOrHeadOffice() || (isSiteStoreRole() && isAuthorizedForSite(storeId));
      allow delete: if isAdminOrHeadOffice();
    }
    match /registeredWarehouses/{warehouseId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isProjectManager();
      allow create, update: if !isSignedIn() || (isWarehouseRole() && isAuthorizedForWarehouse(warehouseId));
      allow delete: if isAdminOrHeadOffice();
    }
    match /warehouses/{warehouseId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isProjectManager();
      allow create, update: if !isSignedIn() || (isWarehouseRole() && isAuthorizedForWarehouse(warehouseId));
      allow delete: if isAdminOrHeadOffice();
    }
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if true;
    }
    match /floorZones/{fzId} {
      allow read: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isSiteEngineer();
      allow create, update: if !isSignedIn() || isSiteStoreRole() || isProjectManager() || isSiteEngineer() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    // 3. Employees, Workers & Teams
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if true;
    }
    match /workers/{workerId} {
      allow read: if true;
      allow write: if true;
    }
    match /teams/{teamId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Attendance & Worker Evaluations
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }
    match /evaluations/{evaluationId} {
      allow read, write: if true;
    }

    // 5. Payroll
    match /payroll/{payrollId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Materials, Material Categories, Inventory & Audits
    match /materials/{materialId} {
      allow read: if true;
      allow create: if !isSignedIn() || isWarehouseRole();
      allow update: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /materialCategories/{categoryId} {
      allow read: if true;
      allow create, update: if !isSignedIn() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /inventory/{inventoryId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow create, update: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /inventoryAudits/{auditId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole() || isFinanceManager();
      allow create, update: if !isSignedIn() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    // 7. Equipment & Vehicles
    match /equipment/{equipmentId} {
      allow read, write: if true;
    }
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // 8. Formwork Panels & Panel Logs
    match /formworkPanels/{panelId} {
      allow read: if true;
      allow create, update: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice() || isWarehouseRole();
    }
    match /panelMovementLogs/{logId} {
      allow read, create, update: if true;
      allow delete: if isAdminOrHeadOffice();
    }
    match /panelDamageReports/{reportId} {
      allow read, write: if true;
    }
    match /panelRepairRecords/{recordId} {
      allow read, write: if true;
    }

    // 9. Warehouse & Site Store Canonical Workflows (Requests, Transfers, Receipts, Issues, Returns, Counts, Adjustments, Discrepancies, Transactions)
    match /overseasShipments/{shipmentId} {
      allow read, write: if !isSignedIn() || isWarehouseRole() || isFinanceManager();
    }
    match /customsRecords/{recordId} {
      allow read, write: if !isSignedIn() || isWarehouseRole() || isFinanceManager();
    }
    match /suppliers/{supplierId} {
      allow read, create, update: if !isSignedIn() || isWarehouseRole() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }
    match /supplierSchedules/{scheduleId} {
      allow read, create, update: if !isSignedIn() || isWarehouseRole() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }
    match /goodsReceipts/{grnId} {
      allow read, create, update: if !isSignedIn() || isWarehouseRole() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }
    match /stockAdjustments/{adjustmentId} {
      allow read, create, update: if !isSignedIn() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /stockTransactions/{txId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole() || isFinanceManager();
      allow create: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow update, delete: if false;
    }
    match /stockTransfers/{transferId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow create: if !isSignedIn() || isWarehouseRole();
      allow update: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /dispatchTransfers/{transferId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow create: if !isSignedIn() || isWarehouseRole();
      allow update: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /stockDiscrepancies/{discrepancyId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow create: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole();
      allow update: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /siteReceivingReports/{reportId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow create, update: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /materialIssues/{recordId} {
      allow read: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager();
      allow create, update: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /materialIssueRecords/{recordId} {
      allow read: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager();
      allow create, update: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /materialReturns/{recordId} {
      allow read: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager();
      allow create, update: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /materialReturnRecords/{recordId} {
      allow read: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager();
      allow create, update: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /materialRequests/{requestId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole() || isProjectManager();
      allow create: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole();
      allow update: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /stockCounts/{countId} {
      allow read: if !isSignedIn() || isSiteStoreRole() || isAdminOrHeadOffice();
      allow create, update: if !isSignedIn() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /damagedMissingReports/{reportId} {
      allow read: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager();
      allow create, update: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /truckFleets/{fleetId} {
      allow read: if !isSignedIn() || isWarehouseRole() || isSiteStoreRole();
      allow create, update: if !isSignedIn() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }
    match /sitePanelBreakdowns/{breakdownId} {
      allow read: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isSiteEngineer();
      allow create, update: if !isSignedIn() || isSiteStoreRole() || isProjectManager() || isSiteEngineer() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }
    match /dailyRequisitions/{reqId} {
      allow read, create, update: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }
    match /dailyConsumptionVariances/{varId} {
      allow read, create, update: if !isSignedIn() || isSiteStoreRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }
    match /requisitionAuditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /dailyReturnReports/{repId} {
      allow read, create, update: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }
    match /dailyConsolidatedReports/{repId} {
      allow read, create, update: if !isSignedIn() || isSiteStoreRole() || isWarehouseRole() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 10. CAD Files & Site Operational Logs
    match /cadFiles/{cadId} {
      allow read, write: if true;
    }
    match /dailyReports/{reportId} {
      allow read, write: if true;
    }
    match /progressLogs/{logId} {
      allow read, write: if true;
    }
    match /qualityLogs/{logId} {
      allow read, write: if true;
    }
    match /qualitySnags/{snagId} {
      allow read, write: if true;
    }
    match /safetyLogs/{logId} {
      allow read, write: if true;
    }
    match /concreteTruckLogs/{truckId} {
      allow read, write: if true;
    }

    // 11. Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // 12. Approvals
    match /approvals/{approvalId} {
      allow read, write: if true;
    }

    // 13. Expenses, Invoices, & Contracts
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }
    match /contracts/{contractId} {
      allow read, write: if true;
    }

    // 14. Audit Logs
    match /auditLogs/{logId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 15. Admin Invitations
    match /invitations/{inviteId} {
      allow read, write: if true;
    }
    // 16. Enterprise ERP Hub Collections (Procurement, Feedbacks, Appraisals)
    match /procurements/{procId} {
      allow read, write: if true;
    }
    match /employeeFeedbacks/{feedbackId} {
      allow read, write: if true;
    }
    match /performanceAppraisals/{appraisalId} {
      allow read, write: if true;
    }

    // 17. Batch B Enterprise Collections
    // 17.1 enterpriseDocuments
    match /enterpriseDocuments/{docId} {
      allow read, write: if true;
    }

    // 17.2 enterpriseChatMessages
    match /enterpriseChatMessages/{messageId} {
      allow read, write: if true;
    }

    // 17.3 clientApprovals
    match /clientApprovals/{approvalId} {
      allow read, write: if true;
    }

    // 17.4 siteDiaryLogs
    match /siteDiaryLogs/{logId} {
      allow read, write: if true;
    }

    // 18. Batch C Enterprise Collections
    // 18.1 projectPermits
    match /projectPermits/{permitId} {
      allow read, write: if true;
    }

    // 18.2 enterpriseAssets
    match /enterpriseAssets/{assetId} {
      allow read, write: if true;
    }

    // 18.3 maintenanceSchedules
    match /maintenanceSchedules/{scheduleId} {
      allow read, write: if true;
    }

    // 18.4 costTrackingItems
    match /costTrackingItems/{itemId} {
      allow read, write: if true;
    }

    // 19. Batch D Enterprise Collections
    // 19.1 aiRiskAssessments
    match /aiRiskAssessments/{riskId} {
      allow read, write: if true;
    }

    // 19.2 trainingRecords
    match /trainingRecords/{recordId} {
      allow read, write: if true;
    }

    // 19.3 apiIntegrationLogs
    match /apiIntegrationLogs/{logId} {
      allow read, write: if true;
    }

    // 20. Batch E Enterprise Collections
    // 20.1 backupLogs
    match /backupLogs/{logId} {
      allow read, write: if true;
    }

    // 20.2 approvalWorkflows
    match /approvalWorkflows/{workflowId} {
      allow read, write: if true;
    }

    // 21. Finance ERP Collections
    // 21.1 projectBudgets
    match /projectBudgets/{budgetId} {
      allow read, write: if true;
    }

    // 21.2 paymentRecords
    match /paymentRecords/{paymentId} {
      allow read, write: if true;
    }
  }
}

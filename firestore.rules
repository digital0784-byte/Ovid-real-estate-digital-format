rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default safety net: Lock down all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // SECURITY UTILITIES & HELPER FUNCTIONS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Retrieve active user profile and roles from the secure users collection safely
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() && ('role' in getUserData()) ? getUserData().role : 'Pending';
    }

    // Role membership predicates
    function hasRole(role) {
      return isSignedIn() && getUserRole() == role;
    }

    function isSuperAdmin() {
      return hasRole('Super Admin');
    }

    function isHeadOffice() {
      return hasRole('Head Office');
    }

    function isProjectManager() {
      return hasRole('Project Manager');
    }

    function isSiteEngineer() {
      return hasRole('Site Engineer');
    }

    function isSupervisor() {
      return hasRole('Supervisor');
    }

    function isTimeKeeper() {
      return hasRole('Time Keeper');
    }

    function isStoreManager() {
      return hasRole('Store Manager');
    }

    function isWarehouseManager() {
      return hasRole('Warehouse Manager');
    }

    function isStoreOwner() {
      return hasRole('Store Owner');
    }

    function isHRManager() {
      return hasRole('HR Manager');
    }

    function isFinanceManager() {
      return hasRole('Finance Manager');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ID validation sanity check
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==========================================
    // MODULE-SPECIFIC RULE MATCHING
    // ==========================================

    // 1. Users collection & Role Change Requests
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSuperAdmin() || isHRManager() || request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }
    match /role_change_requests/{reqId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSuperAdmin() || isHRManager();
      allow delete: if isSuperAdmin();
    }

    // 2. Projects, Sites & Registered Sites / Warehouses
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager();
    }
    match /sites/{siteId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager();
    }
    match /registeredSites/{siteId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager();
    }
    match /registeredWarehouses/{warehouseId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isStoreManager() || isWarehouseManager() || isStoreOwner();
    }
    match /zones/{zoneId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isSiteEngineer();
    }

    // 3. Employees, Workers & Teams
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if true;
    }
    match /workers/{workerId} {
      allow read: if true;
      allow write: if true;
    }
    match /teams/{teamId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Attendance & Worker Evaluations
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isTimeKeeper() || isSupervisor() || isProjectManager();
    }
    match /evaluations/{evaluationId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isHRManager() || isProjectManager() || isSupervisor();
    }

    // 5. Payroll
    match /payroll/{payrollId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Materials, Inventory & Audits
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /inventory/{inventoryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /inventoryAudits/{auditId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 7. Equipment & Vehicles
    match /equipment/{equipmentId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager() || isSiteEngineer() || isSupervisor();
    }
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }

    // 8. Formwork Panels & Panel Logs
    match /formworkPanels/{panelId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /panelMovementLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /panelDamageReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /panelRepairRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }

    // 9. Overseas Shipments, Customs, Transfers & Receiving Reports
    match /overseasShipments/{shipmentId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager() || isFinanceManager();
    }
    match /customsRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager() || isFinanceManager();
    }
    match /dispatchTransfers/{transferId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager() || isSiteEngineer();
    }
    match /siteReceivingReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /materialIssueRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /materialReturnRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /materialRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }
    match /truckFleets/{fleetId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }
    match /supplierSchedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }
    match /sitePanelBreakdowns/{breakdownId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }
    match /dailyRequisitions/{reqId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }
    match /dailyConsumptionVariances/{varId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }
    match /requisitionAuditLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }
    match /dailyReturnReports/{repId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }
    match /dailyConsolidatedReports/{repId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isProjectManager();
    }

    // 10. CAD Files & Site Operational Logs
    match /cadFiles/{cadId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isProjectManager();
    }
    match /dailyReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /progressLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /qualityLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /qualitySnags/{snagId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /safetyLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /concreteTruckLogs/{truckId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor();
    }

    // 11. Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isHRManager() || isFinanceManager() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isSignedIn();
    }

    // 12. Approvals
    match /approvals/{approvalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isHRManager();
      allow delete: if isSuperAdmin();
    }

    // 13. Expenses, Invoices, & Contracts
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isFinanceManager() || isProjectManager();
      allow write: if isSuperAdmin() || isHeadOffice() || isFinanceManager();
    }
    match /contracts/{contractId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isFinanceManager() || isProjectManager();
      allow write: if isSuperAdmin() || isHeadOffice() || isFinanceManager();
    }

    // 14. Audit Logs (Append-Only and strictly Immutable once written)
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isHRManager();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }

    // 15. Admin Invitations
    match /invitations/{inviteId} {
      allow read, write: if isSuperAdmin() || isHeadOffice() || isHRManager();
    }
    // 16. Enterprise ERP Hub Collections (Procurement, Feedbacks, Appraisals)
    match /procurements/{procId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isStoreManager() || isWarehouseManager() || isStoreOwner() || isFinanceManager();
    }
    match /employeeFeedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /performanceAppraisals/{appraisalId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isHRManager() || isProjectManager() || isSupervisor();
    }

    // 17. Batch B Enterprise Collections
    // 17.1 enterpriseDocuments
    match /enterpriseDocuments/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager();
    }

    // 17.2 enterpriseChatMessages
    match /enterpriseChatMessages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // 17.3 clientApprovals
    match /clientApprovals/{approvalId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isFinanceManager();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isFinanceManager();
    }

    // 17.4 siteDiaryLogs
    match /siteDiaryLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default safety net: Lock down all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // SECURITY UTILITIES & HELPER FUNCTIONS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Retrieve active user profile and roles from the secure users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    // Role membership predicates
    function hasRole(role) {
      return isSignedIn() && getUserRole() == role;
    }

    function isSuperAdmin() {
      return hasRole('Super Admin');
    }

    function isHeadOffice() {
      return hasRole('Head Office');
    }

    function isProjectManager() {
      return hasRole('Project Manager');
    }

    function isSiteEngineer() {
      return hasRole('Site Engineer');
    }

    function isSupervisor() {
      return hasRole('Supervisor');
    }

    function isTimeKeeper() {
      return hasRole('Time Keeper');
    }

    function isStoreManager() {
      return hasRole('Store Manager');
    }

    function isHRManager() {
      return hasRole('HR Manager');
    }

    function isFinanceManager() {
      return hasRole('Finance Manager');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ID validation sanity check
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==========================================
    // MODULE-SPECIFIC RULE MATCHING
    // ==========================================

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isHeadOffice() ||
        isHRManager() ||
        isOwner(userId)
      );
      allow delete: if isSuperAdmin();
    }

    // 2. Projects, Sites & Registered Sites
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager();
    }
    match /sites/{siteId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager();
    }
    match /registeredSites/{siteId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager();
    }
    match /zones/{zoneId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isSiteEngineer();
    }

    // 3. Employees, Workers & Teams
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isHRManager();
    }
    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isHRManager();
    }
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isHRManager() || isProjectManager();
    }

    // 4. Attendance & Worker Evaluations
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isTimeKeeper() || isSupervisor() || isProjectManager();
    }
    match /evaluations/{evaluationId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isHRManager() || isProjectManager() || isSupervisor();
    }

    // 5. Payroll
    match /payroll/{payrollId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isFinanceManager() || isHRManager() || (isSignedIn() && existing().employeeId == request.auth.uid);
      allow write: if isSuperAdmin() || isHeadOffice() || isFinanceManager();
    }

    // 6. Materials, Inventory & Audits
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /inventory/{inventoryId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /inventoryAudits/{auditId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }

    // 7. Equipment & Vehicles
    match /equipment/{equipmentId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager() || isSiteEngineer() || isSupervisor();
    }
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }

    // 8. Formwork Panels & Panel Logs
    match /formworkPanels/{panelId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /panelMovementLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /panelDamageReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /panelRepairRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }

    // 9. Overseas Shipments, Customs, Transfers & Receiving Reports
    match /overseasShipments/{shipmentId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager() || isFinanceManager();
    }
    match /customsRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager() || isFinanceManager();
    }
    match /dispatchTransfers/{transferId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager() || isSiteEngineer();
    }
    match /siteReceivingReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager() || isSiteEngineer() || isSupervisor();
    }
    match /materialIssueRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /materialReturnRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /materialRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /truckFleets/{fleetId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /supplierSchedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /sitePanelBreakdowns/{breakdownId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /dailyRequisitions/{reqId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /dailyConsumptionVariances/{varId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /requisitionAuditLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /dailyReturnReports/{repId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }
    match /dailyConsolidatedReports/{repId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager();
    }

    // 10. CAD Files & Site Operational Logs
    match /cadFiles/{cadId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isProjectManager();
    }
    match /dailyReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /progressLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /qualityLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /qualitySnags/{snagId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /safetyLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isSiteEngineer() || isSupervisor() || isProjectManager();
    }
    match /concreteTruckLogs/{truckId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor();
    }

    // 11. Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isHRManager() || isFinanceManager();
    }

    // 12. Approvals
    match /approvals/{approvalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isFinanceManager() || isHRManager();
      allow delete: if isSuperAdmin();
    }

    // 13. Expenses, Invoices, & Contracts
    match /expenses/{expenseId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isFinanceManager() || isProjectManager();
      allow write: if isSuperAdmin() || isHeadOffice() || isFinanceManager();
    }
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isFinanceManager() || isProjectManager();
      allow write: if isSuperAdmin() || isHeadOffice() || isFinanceManager();
    }
    match /contracts/{contractId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isFinanceManager() || isProjectManager();
      allow write: if isSuperAdmin() || isHeadOffice() || isFinanceManager();
    }

    // 14. Audit Logs (Append-Only and strictly Immutable once written)
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isHRManager();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }

    // 15. Admin Invitations
    match /invitations/{inviteId} {
      allow read, write: if isSuperAdmin() || isHeadOffice() || isHRManager();
    }
    // 16. Enterprise ERP Hub Collections (Procurement, Feedbacks, Appraisals)
    match /procurements/{procId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isProjectManager() || isStoreManager() || isFinanceManager();
    }
    match /employeeFeedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /performanceAppraisals/{appraisalId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isHeadOffice() || isHRManager() || isProjectManager() || isSupervisor();
    }
  }
}

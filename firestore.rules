rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default safety net: Lock down all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // SECURITY UTILITIES & HELPER FUNCTIONS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Retrieve active user profile and roles from the secure users collection safely
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() && ('role' in getUserData()) ? getUserData().role : 'Pending';
    }

    // Role membership predicates
    function hasRole(role) {
      return isSignedIn() && getUserRole() == role;
    }

    // Only Super Admin: Name Nuriye Ahmed Adem, phone 0910097862/0920843843, email mejennur669@gmail.com
    function isSuperAdmin() {
      return (isSignedIn() && (
        (('email' in request.auth.token) && request.auth.token.email == 'mejennur669@gmail.com') ||
        (('phone_number' in request.auth.token) && request.auth.token.phone_number == '+251910097862') ||
        (('phone_number' in request.auth.token) && request.auth.token.phone_number == '+251920843843') ||
        (userDocExists() && (
          (('email' in getUserData()) && getUserData().email == 'mejennur669@gmail.com') ||
          (('phoneNumber' in getUserData()) && (
            getUserData().phoneNumber == '0910097862/0920843843' ||
            getUserData().phoneNumber == '0910097862' ||
            getUserData().phoneNumber == '0920843843' ||
            getUserData().phoneNumber == '+251910097862' ||
            getUserData().phoneNumber == '+251920843843'
          ))
        ))
      )) || hasRole('Super Admin');
    }

    function isHeadOffice() {
      return hasRole('Head Office');
    }

    function isProjectManager() {
      return hasRole('Project Manager');
    }

    function isSiteEngineer() {
      return hasRole('Site Engineer');
    }

    function isSupervisor() {
      return hasRole('Supervisor');
    }

    function isTimeKeeper() {
      return hasRole('Time Keeper');
    }

    function isStoreManager() {
      return hasRole('Store Manager');
    }

    function isWarehouseManager() {
      return hasRole('Warehouse Manager') || hasRole('warehouse_manager');
    }

    function isStoreOwner() {
      return hasRole('Store Owner') || hasRole('Site Store Owner') || hasRole('site_store_owner');
    }

    function isAdminOrHeadOffice() {
      return isSuperAdmin() || isHeadOffice() || hasRole('admin') || hasRole('head_office');
    }

    function isWarehouseRole() {
      return isAdminOrHeadOffice() || isWarehouseManager();
    }

    function isSiteStoreRole() {
      return isAdminOrHeadOffice() || isStoreOwner() || isStoreManager();
    }

    function isAuthorizedForSite(siteName) {
      return isAdminOrHeadOffice() || (
        isSiteStoreRole() && (
          !userDocExists() ||
          !('assignedSite' in getUserData()) ||
          getUserData().assignedSite == '' ||
          getUserData().assignedSite == siteName ||
          getUserData().assignedProject == siteName
        )
      );
    }

    function isAuthorizedForWarehouse(warehouseName) {
      return isAdminOrHeadOffice() || (
        isWarehouseRole() && (
          !userDocExists() ||
          !('assignedWarehouse' in getUserData()) ||
          getUserData().assignedWarehouse == '' ||
          getUserData().assignedWarehouse == warehouseName
        )
      );
    }

    function isHRManager() {
      return hasRole('HR Manager');
    }

    function isFinanceManager() {
      return hasRole('Finance Manager');
    }

    function isAuditor() {
      return hasRole('Auditor');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ID validation sanity check
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==========================================
    // MODULE-SPECIFIC RULE MATCHING
    // ==========================================

    // 1. Users collection, Registrants & Role Change Requests
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || isHeadOffice() || isHRManager() || (
        isOwner(userId) &&
        incoming().keys().hasOnly([
          'displayName', 'email', 'phoneNumber', 'role', 'status', 'createdAt',
          'employeeId', 'name', 'department', 'trade', 'position', 'requestedRole',
          'id', 'uid'
        ]) &&
        incoming().role == 'Pending' &&
        incoming().status == 'Pending'
      );
      allow update: if isSuperAdmin() || isHeadOffice() || isHRManager() || (
        isOwner(userId) &&
        incoming().role == existing().role &&
        incoming().status == existing().status &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'phoneNumber', 'createdAt',
          'employeeId', 'name', 'department', 'trade', 'position', 'requestedRole',
          'id', 'uid'
        ])
      );
      allow delete: if isSuperAdmin();
    }

    match /registrants/{regId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isHRManager() || (
        isSignedIn() && (
          regId == request.auth.uid ||
          (resource != null && (
            ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
            ('uid' in resource.data && resource.data.uid == request.auth.uid)
          ))
        )
      );
      allow create: if isSignedIn() && (
        regId == request.auth.uid ||
        ('userId' in incoming() && incoming().userId == request.auth.uid) ||
        ('uid' in incoming() && incoming().uid == request.auth.uid)
      );
      allow update: if isSuperAdmin() || isHeadOffice() || isHRManager();
      allow delete: if isSuperAdmin() || isHeadOffice();
    }

    match /role_change_requests/{reqId} {
      allow read: if isSuperAdmin() || isHeadOffice() || isHRManager() || (
        isSignedIn() && (
          reqId == request.auth.uid ||
          (resource != null && (
            ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
            ('uid' in resource.data && resource.data.uid == request.auth.uid)
          ))
        )
      );
      allow create: if isSignedIn() && (
        reqId == request.auth.uid ||
        ('userId' in incoming() && incoming().userId == request.auth.uid) ||
        ('uid' in incoming() && incoming().uid == request.auth.uid)
      );
      allow update: if isSuperAdmin() || isHeadOffice() || isHRManager();
      allow delete: if isSuperAdmin() || isHeadOffice();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrHeadOffice();
    }

    // 2. Projects, Sites & Registered Sites / Warehouses (Role-Scoped)
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /sites/{siteId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /registeredSites/{siteId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || (isSiteStoreRole() && isAuthorizedForSite(siteId)) || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /siteStores/{storeId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || (isSiteStoreRole() && isAuthorizedForSite(storeId));
      allow delete: if isAdminOrHeadOffice();
    }

    match /registeredWarehouses/{warehouseId} {
      allow read: if isSignedIn();
      allow create, update: if (isWarehouseRole() && isAuthorizedForWarehouse(warehouseId));
      allow delete: if isAdminOrHeadOffice();
    }

    match /warehouses/{warehouseId} {
      allow read: if isSignedIn();
      allow create, update: if (isWarehouseRole() && isAuthorizedForWarehouse(warehouseId));
      allow delete: if isAdminOrHeadOffice();
    }

    match /zones/{zoneId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    match /floorZones/{fzId} {
      allow read: if isSignedIn();
      allow create, update: if isSiteStoreRole() || isProjectManager() || isSiteEngineer() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    // 3. Employees, Workers & Teams
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isHRManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isHRManager() || isProjectManager() || isSupervisor();
      allow delete: if isAdminOrHeadOffice() || isHRManager();
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isHRManager() || isProjectManager() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    // 4. Attendance & Worker Evaluations
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isTimeKeeper() || isSupervisor() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /evaluations/{evaluationId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isSupervisor() || isProjectManager() || isHRManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 5. Payroll
    match /payroll/{payrollId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isHRManager() || isProjectManager() || isAuditor();
      allow create, update: if isAdminOrHeadOffice() || isFinanceManager() || isHRManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 6. Materials, Material Categories, Inventory & Audits
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create: if isWarehouseRole();
      allow update: if isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialCategories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /inventory/{inventoryId} {
      allow read: if isSignedIn();
      allow create, update: if isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /inventoryAudits/{auditId} {
      allow read: if isWarehouseRole() || isSiteStoreRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow create, update: if isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    // 7. Equipment & Vehicles
    match /equipment/{equipmentId} {
      allow read: if isSignedIn();
      allow create, update: if isWarehouseRole() || isSiteStoreRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create, update: if isWarehouseRole() || isSiteStoreRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    // 8. Formwork Panels & Panel Logs
    match /formworkPanels/{panelId} {
      allow read: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole() || isProjectManager() || isSiteEngineer();
      allow create, update, delete: if isAdminOrHeadOffice() || isWarehouseRole();
    }

    match /panelMovementLogs/{logId} {
      allow read: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole() || isProjectManager();
      allow create, update: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /panelDamageReports/{reportId} {
      allow read: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole() || isProjectManager() || isSiteEngineer();
      allow create, update: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole() || isSiteEngineer() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    match /panelRepairRecords/{recordId} {
      allow read: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole();
      allow create, update: if isAdminOrHeadOffice() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    // 9. Warehouse & Site Store Canonical Workflows
    match /overseasShipments/{shipmentId} {
      allow read: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow write: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
    }

    match /customsRecords/{recordId} {
      allow read: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow write: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /supplierSchedules/{scheduleId} {
      allow read: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow create, update: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /goodsReceipts/{grnId} {
      allow read: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow create, update: if isWarehouseRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockAdjustments/{adjustmentId} {
      allow read: if isWarehouseRole() || isAdminOrHeadOffice();
      allow create, update: if isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockTransactions/{transactionId} {
      allow read: if isWarehouseRole() || isSiteStoreRole() || isFinanceManager() || isAdminOrHeadOffice();
      allow create: if isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice();
      allow update, delete: if false; // Immutable audit ledger
    }

    match /stockTransfers/{transferId} {
      allow read: if isSignedIn();
      allow create: if isWarehouseRole() || isSiteStoreRole();
      allow update: if isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dispatchTransfers/{transferId} {
      allow read: if isSignedIn();
      allow create: if isWarehouseRole();
      allow update: if isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockDiscrepancies/{discrepancyId} {
      allow read: if isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice();
      allow create: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow update: if isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /siteReceivingReports/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialIssues/{recordId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialIssueRecords/{recordId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialReturns/{recordId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialReturnRecords/{recordId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /materialRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isWarehouseRole() || isSiteStoreRole() || isAdminOrHeadOffice() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockCounts/{countId} {
      allow read: if isSiteStoreRole() || isAdminOrHeadOffice() || isWarehouseRole();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /damagedMissingReports/{reportId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice() || isSiteEngineer() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    match /truckFleets/{fleetId} {
      allow read: if isSignedIn();
      allow create, update: if isWarehouseRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /sitePanelBreakdowns/{breakdownId} {
      allow read: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole() || isProjectManager();
      allow create, update: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dailyRequisitions/{reqId} {
      allow read: if isSignedIn();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isSupervisor() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dailyConsumptionVariances/{varId} {
      allow read: if isSiteStoreRole() || isProjectManager() || isAdminOrHeadOffice() || isWarehouseRole();
      allow create, update: if isSiteStoreRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /requisitionAuditLogs/{logId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    match /dailyReturnReports/{repId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dailyConsolidatedReports/{repId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isWarehouseRole() || isProjectManager() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /dailyMaterialReports/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isSiteStoreRole() || isAdminOrHeadOffice() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /enhancedMaterialRequests/{requestId} {
      allow read: if isAdminOrHeadOffice() || isSiteStoreRole() || isProjectManager() ||
                     (resource.data.requesterUid == request.auth.uid) ||
                     (userDocExists() && 'assignedSite' in getUserData() && getUserData().assignedSite == resource.data.site);
      allow create: if (isSignedIn() && (
                      isAdminOrHeadOffice() || isSiteStoreRole() ||
                      (request.resource.data.requesterUid == request.auth.uid)
                    ));
      allow update: if isAdminOrHeadOffice() ||
                     // Site store owner can approve/reject/issue, but requester CANNOT approve own request
                     (isSiteStoreRole() && (isSuperAdmin() || resource.data.requesterUid != request.auth.uid)) ||
                     // Requester can confirm receipt or cancel draft
                     (resource.data.requesterUid == request.auth.uid && request.resource.data.status in ['RECEIVED', 'CONSUMED', 'PARTIALLY_RETURNED', 'RETURNED', 'CLOSED']);
      allow delete: if isAdminOrHeadOffice();
    }

    match /enhancedMaterialIssues/{issueId} {
      allow read: if isAdminOrHeadOffice() || isSiteStoreRole() ||
                     (resource.data.requesterUid == request.auth.uid) ||
                     (resource.data.receivedByUid == request.auth.uid);
      allow create: if isSiteStoreRole() || isAdminOrHeadOffice();
      allow update: if isSiteStoreRole() || isAdminOrHeadOffice() ||
                     (request.auth.uid == resource.data.receivedByUid);
      allow delete: if isAdminOrHeadOffice();
    }

    match /enhancedMaterialReturns/{returnId} {
      allow read: if isAdminOrHeadOffice() || isSiteStoreRole() ||
                     (resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSiteStoreRole() || isAdminOrHeadOffice();
      allow delete: if isAdminOrHeadOffice();
    }

    match /stockReservations/{resId} {
      allow read, write: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
    }

    match /inventoryDiscrepancies/{discrepancyId} {
      allow read: if isSiteStoreRole() || isWarehouseRole() || isAdminOrHeadOffice();
      allow create, update: if isSiteStoreRole() || isAdminOrHeadOffice() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    // 10. CAD Files & Site Operational Logs
    match /cadFiles/{cadId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || hasRole('CAD Engineer') || hasRole('Surveyor');
      allow delete: if isAdminOrHeadOffice() || isProjectManager();
    }

    match /dailyReports/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    match /progressLogs/{logId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    match /qualityLogs/{logId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || hasRole('QA/QC Engineer') || hasRole('Quality Inspector');
      allow delete: if isAdminOrHeadOffice();
    }

    match /qualitySnags/{snagId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor() || hasRole('QA/QC Engineer');
      allow delete: if isAdminOrHeadOffice();
    }

    match /safetyLogs/{logId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor() || hasRole('Safety Officer') || hasRole('HSE Officer');
      allow delete: if isAdminOrHeadOffice();
    }

    match /concreteTruckLogs/{truckId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    // 11. Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdminOrHeadOffice() ||
        (resource != null && (
          ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
          ('recipientId' in resource.data && resource.data.recipientId == request.auth.uid)
        ))
      );
      allow delete: if isAdminOrHeadOffice() || (
        isSignedIn() && (
          resource != null && (
            ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
            ('recipientId' in resource.data && resource.data.recipientId == request.auth.uid)
          )
        )
      );
    }

    // 12. Approvals
    match /approvals/{approvalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdminOrHeadOffice() || isProjectManager() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 12.1 Tasks (Digital Construction ERP Tasks Management)
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor() || hasRole('Team Leader') || hasRole('Gang Chief') || (
        isSignedIn() && (
          ('assignedToId' in resource.data && resource.data.assignedToId == request.auth.uid) ||
          ('createdById' in resource.data && resource.data.createdById == request.auth.uid)
        )
      );
      allow delete: if isAdminOrHeadOffice() || isProjectManager();
    }

    // 13. Expenses, Invoices, & Contracts
    match /expenses/{expenseId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isProjectManager();
      allow create, update: if isAdminOrHeadOffice() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /invoices/{invoiceId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isProjectManager();
      allow create, update: if isAdminOrHeadOffice() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /contracts/{contractId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isProjectManager();
      allow create, update: if isAdminOrHeadOffice() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 14. Audit Logs (read for Admin/HR/Finance/Auditor, create for signed-in, immutable)
    match /auditLogs/{logId} {
      allow read: if isAdminOrHeadOffice() || isHRManager() || isFinanceManager() || isAuditor();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    // 15. Admin Invitations
    match /invitations/{inviteId} {
      allow read, write: if isSuperAdmin() || isHeadOffice() || isHRManager();
    }

    // 16. Enterprise ERP Hub Collections (Procurement, Feedbacks, Appraisals)
    match /procurements/{procId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isFinanceManager() || isProjectManager() || isWarehouseRole();
      allow delete: if isAdminOrHeadOffice();
    }

    match /employeeFeedbacks/{feedbackId} {
      allow read: if isAdminOrHeadOffice() || isHRManager() || (
        isSignedIn() && (
          ('employeeId' in resource.data && resource.data.employeeId == request.auth.uid) ||
          ('submittedBy' in resource.data && resource.data.submittedBy == request.auth.uid)
        )
      );
      allow create: if isSignedIn();
      allow update: if isAdminOrHeadOffice() || isHRManager();
      allow delete: if isAdminOrHeadOffice();
    }

    match /performanceAppraisals/{appraisalId} {
      allow read: if isAdminOrHeadOffice() || isHRManager() || (
        isSignedIn() && ('employeeId' in resource.data && resource.data.employeeId == request.auth.uid)
      );
      allow create, update: if isAdminOrHeadOffice() || isHRManager() || isProjectManager() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    // 17. Batch B Enterprise Collections
    // 17.1 enterpriseDocuments
    match /enterpriseDocuments/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isHRManager() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 17.2 enterpriseChatMessages
    match /enterpriseChatMessages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdminOrHeadOffice() || (
        isSignedIn() && ('senderId' in resource.data && resource.data.senderId == request.auth.uid)
      );
    }

    // 17.3 clientApprovals
    match /clientApprovals/{approvalId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 17.4 siteDiaryLogs
    match /siteDiaryLogs/{logId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || isSupervisor();
      allow delete: if isAdminOrHeadOffice();
    }

    // 18. Batch C Enterprise Collections
    // 18.1 projectPermits
    match /projectPermits/{permitId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer();
      allow delete: if isAdminOrHeadOffice();
    }

    // 18.2 enterpriseAssets
    match /enterpriseAssets/{assetId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isWarehouseRole() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 18.3 maintenanceSchedules
    match /maintenanceSchedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isWarehouseRole() || isSiteStoreRole();
      allow delete: if isAdminOrHeadOffice();
    }

    // 18.4 costTrackingItems
    match /costTrackingItems/{itemId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isProjectManager();
      allow create, update: if isAdminOrHeadOffice() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 19. Batch D Enterprise Collections
    // 19.1 aiRiskAssessments
    match /aiRiskAssessments/{riskId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isSiteEngineer() || hasRole('Safety Officer') || hasRole('HSE Officer');
      allow delete: if isAdminOrHeadOffice();
    }

    // 19.2 trainingRecords
    match /trainingRecords/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isHRManager() || isProjectManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 19.3 apiIntegrationLogs
    match /apiIntegrationLogs/{logId} {
      allow read: if isAdminOrHeadOffice();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable system audit log
    }

    // 20. Batch E Enterprise Collections
    // 20.1 backupLogs
    match /backupLogs/{logId} {
      allow read: if isAdminOrHeadOffice();
      allow create: if isAdminOrHeadOffice();
      allow update, delete: if false; // Immutable backup audit log
    }

    // 20.2 approvalWorkflows
    match /approvalWorkflows/{workflowId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrHeadOffice() || isProjectManager() || isHRManager() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 21. Finance ERP Collections
    // 21.1 projectBudgets
    match /projectBudgets/{budgetId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isProjectManager();
      allow create, update: if isAdminOrHeadOffice() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // 21.2 paymentRecords
    match /paymentRecords/{paymentId} {
      allow read: if isAdminOrHeadOffice() || isFinanceManager() || isProjectManager();
      allow create, update: if isAdminOrHeadOffice() || isFinanceManager();
      allow delete: if isAdminOrHeadOffice();
    }

    // ==========================================
    // 22. Panel Traceability & Lifecycle Collections
    // ==========================================
    function isTraceabilityWriter() {
      return isSuperAdmin() || isHeadOffice() || isStoreManager() || isProjectManager() || isSiteEngineer() || isSupervisor() || isWarehouseRole() || isSiteStoreRole();
    }

    // 22.1 traceablePanels
    match /traceablePanels/{panelId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isTraceabilityWriter();
    }

    // 22.2 panelTraceabilityMovements
    match /panelTraceabilityMovements/{movementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isTraceabilityWriter();
    }

    // 22.3 panelDamageInspections
    match /panelDamageInspections/{inspectionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isTraceabilityWriter();
    }

    // 22.4 panelIssueTransactions
    match /panelIssueTransactions/{issueId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isTraceabilityWriter();
    }

    // 22.5 panelReturnTransactions
    match /panelReturnTransactions/{returnId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isTraceabilityWriter();
    }

    // 22.6 panelInventoryReconciliations
    match /panelInventoryReconciliations/{reconciliationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isTraceabilityWriter();
    }

    // 22.7 panelTraceabilityAuditLogs (create-only and immutable like auditLogs)
    match /panelTraceabilityAuditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isTraceabilityWriter();
      allow update, delete: if false; // Immutable audit log
    }

    // 22.8 panelDimensionLibrary
    match /panelDimensionLibrary/{dimensionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isTraceabilityWriter();
    }
  }
}
